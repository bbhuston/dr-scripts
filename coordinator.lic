=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#coordinator

  Task scheduler that runs hunting, town and cleanup tasks in priority order.

  Tasks and their predicates come from coordinator_hunting_tasks,
  coordinator_town_tasks and coordinator_hunting_cleanup in your yaml. Predicates
  are evaluated against skills and timers, and timers persist in UserVars.
=end

class Coordinator
  def initialize(debug)
    UserVars.coordinator_timers ||= {}
    # A hold recorded by a previous producer is not this one's observation.
    UserVars.coordinator_safety_hold = nil
    $COORDINATOR = self

    arg_definitions = [
      [
        { name: 'quiet', regex: /^quiet$/i, optional: true,
          description: 'Suppress the per-tick predicate echoes' }
      ]
    ]
    @args = parse_args(arg_definitions, true)

    # A long-running scheduler echoes a predicate line per tick; `quiet`
    # silences that without losing the task and error output.
    @debug = debug && !@args.quiet
    # Accept flex-file suffixes the way t2 does. Upstream called get_settings
    # with no arguments, so every coordinator_* key had to live in the setup
    # file and `;coordinator lifecycle` could not select an overlay.
    @settings = get_settings(@args.flex)
    @hunting_tasks = task_list('coordinator_hunting_tasks', :hunting)
    @town_tasks = task_list('coordinator_town_tasks', :town)
    @cleanup_tasks = task_list('coordinator_hunting_cleanup', :cleanup)
    run_box_handoff_test if box_handoff_test_profile?
    @safe_idle = safe_idle_profile?
    # This explicit caretaker retirement role does not prepare inventory,
    # release spells, start children or travel. The operator returns Grimdur
    # to the safe room before opening the lifecycle producer.
    loop { run_idle_task } if @safe_idle

    if all_tasks.empty?
      raise ArgumentError, 'coordinator requires at least one of coordinator_hunting_tasks, ' \
                           'coordinator_town_tasks or coordinator_hunting_cleanup'
    end

    @song_list = get_data('perform').perform_options

    prepare_tasks

    Flags.add('coord-song', 'you finish playing')
    DRCA.release_cyclics
    loop do
      break unless run_next_task
    end
  end

  def run_next_task
    if (reason = schedule_hold_reason)
      hold_schedule(reason)
      return true
    end
    return unless (task = get_next_task)

    echo("Found task to execute: #{task}") if @debug
    started = Time.now
    case task[:type]
    when :hunting
      run_hunting_task(task)
    when :cleanup, :town
      # Cleanup entries are ordinary town tasks that only become selectable
      # after a hunt. Without this branch they were marked, selected, and then
      # silently unmarked with their timers reset, so a cleanup task could
      # never run.
      run_town_task(task)
    when :idle
      run_idle_task
    end
    return true if @task_hold

    report_completed_task(task, Time.now - started)
    update_predicates_for_completed_task(task)
    true
  end

  def safe_idle_profile?
    return false unless @settings.drbot_lifecycle_role == 'safe_idle'

    unless DRStats.name.to_s.casecmp?('Grimdur') && @settings.safe_room.is_a?(Integer) && @settings.safe_room.positive? && all_tasks.empty?
      raise ArgumentError, 'safe_idle requires Grimdur, a positive configured safe_room, and no coordinator tasks'
    end
    true
  end

  def box_handoff_test_profile?
    return false unless @settings.drbot_lifecycle_role == 'box_handoff_test'

    expected = case DRStats.name.to_s.downcase
               when 'lanjefast'
                 { script: 'lanjefast-collect-boxes', type: :town }
               when 'thargrund'
                 { script: 'drbot-gbox', args: ['backpack'], type: :town }
               end
    unless expected && Array(@args.flex) == ['box-handoff-test'] && !@args.quiet &&
           @settings.safe_room == 52300 && @settings.crossing_training == [] &&
           @settings.coordinator_hunting_tasks == [] && @settings.coordinator_hunting_cleanup == [] &&
           @town_tasks == [expected]
      raise ArgumentError, 'box_handoff_test requires its exact character profile and sole bounded handoff task'
    end
    raise ArgumentError, 'box_handoff_test requires observed Carousel room 8285' unless Room.current && Room.current.id == 8285

    true
  end

  def run_box_handoff_test
    if (reason = schedule_hold_reason)
      hold_box_handoff_test(reason)
    end
    task = @town_tasks.first
    @child_script = task[:script]
    if Script.running?(@child_script)
      hold_box_handoff_test('handoff child already running; operator reconciliation required')
    end
    child = start_script(@child_script, Array(task[:args]))
    hold_box_handoff_test('handoff child start unconfirmed; operator reconciliation required') unless child

    deadline = Time.now + 180
    while Script.list.any? { |candidate| candidate.equal?(child) }
      if Time.now >= deadline
        # Stop only the captured instance: a later same-named child is not
        # ours. Kill is not custody proof or settled game-result evidence;
        # preserve both the child identity and the final-write pending flag.
        begin
          child.kill if Script.list.any? { |candidate| candidate.equal?(child) }
        rescue StandardError
          hold_box_handoff_test('handoff exact-child stop unconfirmed; operator reconciliation required')
        end
        hold_box_handoff_test('handoff child exceeded 180 seconds; custody remains unconfirmed, operator reconciliation required')
      end
      pause 0.25
    end
    control = $DRBOT_DIRECT_CONTROL
    settled = control.is_a?(Hash) && control['pending_result'] == false &&
              checkrt.zero? && checkcastrt.zero? && Room.current && Room.current.id == 8285
    unless settled && child.respond_to?(:drbot_box_handoff_result)
      hold_box_handoff_test('handoff result or final command unconfirmed; operator reconciliation required')
    end
    result = child.drbot_box_handoff_result
    unless result.is_a?(Hash) && result['count'].is_a?(Integer) &&
           ((result['status'] == 'complete' && result['count'] == 1) ||
            (result['status'] == 'skipped' && result['count'] == 0))
      hold_box_handoff_test('handoff child did not report verified completion or a clean skip; operator reconciliation required')
    end
    @child_script = nil
    echo("***COORDINATOR BOX HANDOFF*** #{result['status']}; count=#{result['count']}; #{result['reason'].to_s[0, 160]}")
    hold_box_handoff_test("one-shot handoff #{result['status']}; explicit operator stop required")
  end

  def hold_box_handoff_test(reason)
    @task_hold = reason
    UserVars.coordinator_safety_hold = { 'reason' => reason, 'since' => Time.now.to_f }
    echo("***COORDINATOR HOLD*** #{reason}")
    loop { pause 60 }
  end

  # The same completion line t2 emits, so a long-running schedule leaves the
  # per-task evidence a supervisor reads. Lich prefixes a script echo with its
  # own name, so this arrives as `[coordinator: ***STATUS*** Completed ...]`.
  def report_completed_task(task, elapsed)
    return if task[:type] == :idle

    seconds = elapsed.to_i
    echo(format('***STATUS*** Completed %s in %dh:%02dm:%02ds', task_label(task),
                seconds / 3600, (seconds % 3600) / 60, seconds % 60))
  end

  def task_label(task)
    return "hunt #{task[:file]}" if task[:file]
    return "action #{task[:action]}" if task[:action]
    return [task[:script], *Array(task[:args])].join(' ') if task[:script]
    task[:type].to_s
  end

  # A long-running scheduler needs a stop that halts the whole schedule, not
  # just the current hunt. Neither condition is a hunting-task predicate: a
  # town walk with a bleeder or at the health floor is the dangerous part.
  #
  # Bleeding latches, and acts before it holds. A profile naming a reviewed
  # recovery child (drbot_bleeding_recovery) runs it at once, at most
  # BLEEDING_RECOVERY_ATTEMPTS times per latch and each within
  # BLEEDING_RECOVERY_DEADLINE; the coordinator itself never moves. Only the
  # child's published verified result, together with the bleeding indicator
  # observed clear and the character observed in the configured safe room,
  # clears the latch and lets the schedule resume. Anything else holds until
  # an operator stops the script: a stopped bleeder is not evidence that
  # re-entering the same activity is safe, and a character has bled out after
  # a completed extraction. Without the setting, or while a task or weapon
  # custody hold outranks the latch, the single upstream in-place tend
  # attempt remains.
  #
  # The health floor does not latch. Resting in place is how it recovers, and
  # the hold is exactly that, so the schedule resumes on its own once health
  # is back above the profile's threshold.
  def schedule_hold_reason
    return @task_hold if @task_hold
    if (custody_hold = UserVars.drbot_weapon_custody_hold).is_a?(Hash)
      UserVars.coordinator_safety_hold = custody_hold
      return custody_hold['reason'] || 'weapon custody unresolved; operator reconciliation required'
    end
    # The generic custody hold a reviewed town task records when it cannot
    # prove where coins, a purchase, a workpiece or a tool ended up (first
    # drbot-remedy-restock). It persists in UserVars like the weapon custody
    # hold, so a restarted coordinator holds too, and it is read every tick, so
    # the schedule resumes once an operator has reconciled and cleared it.
    if (custody_hold = UserVars.drbot_custody_hold).is_a?(Hash)
      UserVars.coordinator_safety_hold = custody_hold
      return custody_hold['reason'] || 'custody unresolved; operator reconciliation required'
    end
    return @bleeding_hold if @bleeding_hold
    if @settings.stop_hunting_if_bleeding && bleeding?
      @bleeding_hold = 'bleeding observed; schedule held'
      return @bleeding_hold
    end
    floor = @settings.health_threshold
    health = DRStats.health
    if floor.is_a?(Numeric) && health.is_a?(Numeric) && health < floor
      return "health #{health}% below the profile floor #{floor}%"
    end
    UserVars.coordinator_safety_hold = nil
    nil
  end

  BLEEDING_RECOVERY_ATTEMPTS = 2
  # drbot-bleeding-recovery bounds itself at 900 seconds: TEND, the walk to
  # Martyr Saedelthorp's triage, her touch cycle, the apprentice's list and
  # the walk back. This is the coordinator's own bound on one child run.
  BLEEDING_RECOVERY_DEADLINE = 1200

  def hold_schedule(reason)
    if @bleeding_hold
      # A task or weapon custody hold outranks the latch (schedule_hold_reason
      # returns it first) and must be settled before any child moves.
      latched = reason == @bleeding_hold
      return if recover_from_bleeding(latched)

      reason = @bleeding_hold if latched
    end
    # The echo lands in this character's Lich transcript, which an operator
    # reads through the console; it is not parsed by the daemon. The UserVars
    # key is the readable state (`;e UserVars.coordinator_safety_hold`), so a
    # held schedule is distinguishable from a hung script without scrolling
    # the transcript. It is cleared at startup, when the hold clears, and in
    # before_dying, because UserVars survives a Lich restart.
    UserVars.coordinator_safety_hold ||= { 'reason' => reason, 'since' => Time.now.to_f }
    echo("***COORDINATOR HOLD*** #{reason}")
    pause 60
  end

  # Vrakk 2026-09-28: a held bleeding schedule only waited, and he bled from
  # 18:43 until a guardian extraction at 19:26. The recovery child (a
  # repo-reviewed script named by the profile) acts: it tends or walks to a
  # healer and back, and publishes its result on its Script instance the way
  # a box handoff child does. A retry runs only when that result says a fresh
  # observation found the character still bleeding, never to replay an
  # unconfirmed step.
  #
  # While a task or weapon custody hold outranks the latch no child moves,
  # but the single in-place tend still runs: TEND does not move, and waiting
  # out a bleed behind another hold is how the latch used to idle.
  def recover_from_bleeding(latched)
    script = @settings.drbot_bleeding_recovery
    unless latched && script.is_a?(String) && !script.empty?
      unless @tend_attempted
        @tend_attempted = true
        wait_for_child('tendme') if DRCH.has_tendable_bleeders?
      end
      return false
    end

    @bleeding_recovery_attempts = @bleeding_recovery_attempts.to_i
    return false if @bleeding_recovery_attempts >= BLEEDING_RECOVERY_ATTEMPTS
    return false if @bleeding_recovery_attempts.positive? && !@bleeding_recovery_retryable

    @bleeding_recovery_attempts += 1
    attempt = "#{@bleeding_recovery_attempts}/#{BLEEDING_RECOVERY_ATTEMPTS}"
    # The readable hold state names the running recovery, so a bleeding
    # character mid-recovery never reads as an idle schedule.
    running = "bleeding observed; recovery #{attempt} running (#{script})"
    UserVars.coordinator_safety_hold = { 'reason' => running, 'since' => Time.now.to_f }
    echo("***STATUS*** Bleeding recovery #{attempt}: #{script}")
    child, failure = run_bleeding_recovery_child(script)
    result = child.respond_to?(:drbot_bleeding_recovery_result) ? child.drbot_bleeding_recovery_result : nil
    if !failure && result.is_a?(Hash) && result['status'] == 'stopped' && result['room'] == @settings.safe_room &&
       !bleeding? && Room.current && Room.current.id == @settings.safe_room
      echo("***STATUS*** Bleeding recovery verified (#{result['method']}); schedule hold cleared")
      @bleeding_hold = nil
      @tend_attempted = false
      @bleeding_recovery_attempts = 0
      @bleeding_recovery_retryable = false
      UserVars.coordinator_safety_hold = nil
      return true
    end
    @bleeding_recovery_retryable = !failure && result.is_a?(Hash) && result['retryable'] == true
    detail = if failure
               failure
             elsif result.is_a?(Hash)
               "#{result['status']}: #{result['reason'].to_s[0, 160]}"
             else
               'result unconfirmed'
             end
    @bleeding_hold = "bleeding observed; recovery #{detail}; operator recovery required"
    UserVars.coordinator_safety_hold = { 'reason' => @bleeding_hold, 'since' => Time.now.to_f }
    false
  end

  # Start the recovery child and wait for that exact instance, at most
  # BLEEDING_RECOVERY_DEADLINE. A child still running then is stopped, but
  # only the captured instance, and its result is never trusted. Returns
  # [child, failure]; failure is nil when the child exited on its own.
  def run_bleeding_recovery_child(script)
    return [nil, 'child already running; not started'] if Script.running?(script)

    @child_script = script
    child = start_script(script, [@settings.safe_room.to_s])
    return [nil, 'child start unconfirmed'] unless child

    deadline = Time.now + BLEEDING_RECOVERY_DEADLINE
    while Script.list.any? { |candidate| candidate.equal?(child) }
      if Time.now >= deadline
        begin
          child.kill if Script.list.any? { |candidate| candidate.equal?(child) }
        rescue StandardError
          return [nil, "child exceeded #{BLEEDING_RECOVERY_DEADLINE} seconds; stop unconfirmed"]
        end
        return [nil, "child exceeded #{BLEEDING_RECOVERY_DEADLINE} seconds; stopped, result unconfirmed"]
      end
      pause 0.25
    end
    [child, nil]
  ensure
    @child_script = nil
  end

  def get_next_task
    [@cleanup_tasks, @hunting_tasks, @town_tasks].each do |task_list|
      task_list.reject! { |task| task[:deleted] }
    end
    cleanup_task || town_task || hunting_task || default_hunting_task || idle_task
  end

  def cleanup_task
    @cleanup_tasks.select { |task| task[:marked] }.find { |task| predicate_met?(task) }
  end

  def hunting_task
    @hunting_tasks.find { |task| predicate_met?(task) }
  end

  def town_task
    @town_tasks.find { |task| predicate_met?(task) }
  end

  def default_hunting_task
    task = @hunting_tasks.find { |candidate| candidate[:default] }
    return task unless task && task[:retry_after] && Time.now < task[:retry_after]

    # A box-blocked hunt deferred this one. Recount once after the cleanup
    # chain: a completed box handoff lifts the deferral early.
    if task[:box_recount_pending]
      task[:box_recount_pending] = false
      update_box_count
      unless hunt_boxes_full?(task)
        task[:retry_after] = nil
        return task
      end
    end
    nil
  end

  def idle_task
    { type: :idle }
  end

  def predicate_met?(task)
    return false if task[:retry_after] && Time.now < task[:retry_after]
    return false if task[:action] == 'train_forging' && forging_latched?

    echo("Checking predicates for task: #{task}") if @debug
    start = evaluate_predicate?(task[:start_on])
    if start && !(task[:stop_on].nil? || task[:stop_on].empty?)
      start = !evaluate_predicate?(task[:stop_on])
    end
    start
  end

  def evaluate_predicate?(predicate)
    return true if predicate.nil? || predicate.empty?
    unless predicate.size == 1
      raise ArgumentError, "Predicate with multiple keys: #{predicate}"
    end

    key = predicate.keys.first
    value = predicate[key]

    case key
    when 'or'
      value.any? { |member| evaluate_predicate?(member) }
    when 'and'
      value.all? { |member| evaluate_predicate?(member) }
    when 'skill_less_than', 'skill_under'
      echo("Checking skill #{value['skill']} < #{value['target']}") if @debug
      skill_less_than?(value['skill'], value['target'])
    when 'skill_over'
      echo("Checking skill #{value['skill']} > #{value['target']}") if @debug
      skill_greater_than?(value['skill'], value['target'])
    when 'any_skill_less_than', 'any_skill_under'
      echo("Checking skills #{value['skills']} < #{value['target']}") if @debug
      value['skills'].any? { |skill| skill_less_than?(skill, value['target']) }
    # skill_* above read the learning rate (DRSkill.getxp, mindstate 0..34).
    # Guild circle requirements are stated in ranks, which no predicate could
    # reach, so a task could not be gated on "until Warding is rank 18".
    when 'rank_under'
      echo("Checking rank #{value['skill']} < #{value['target']}") if @debug
      rank_less_than?(value['skill'], value['target'])
    when 'rank_over'
      echo("Checking rank #{value['skill']} > #{value['target']}") if @debug
      rank_greater_than?(value['skill'], value['target'])
    when 'any_rank_under'
      echo("Checking ranks #{value['skills']} < #{value['target']}") if @debug
      value['skills'].any? { |skill| rank_less_than?(skill, value['target']) }
    when 'after_every_hunt'
      key = value['key']
      raise ArgumentError, "Unknown hunt counter: #{key}" unless @hunt_counters.key?(key)
      echo("Checking hunt counter #{key}: #{@hunt_counters[key]}") if @debug
      @hunt_counters[key] > 0
    when 'on_first_run'
      key = value['key']
      raise ArgumentError, "Unknown first-run counter: #{key}" unless @first_run_counters.key?(key)
      echo("Checking first-run counter #{key}: #{@first_run_counters[key]}") if @debug
      @first_run_counters[key]
    when 'boxes_over'
      @num_boxes > value
    when 'boxes_under'
      @num_boxes < value
    when 'encumbrance_over'
      DRC.check_encumbrance > value
    when 'timer'
      Time.now > get_time(value)
    when 'predicate'
      unless all_predicates.include? value
        raise ArgumentError, "Predicate not in whitelist: #{value}"
      end

      send(value)
    else
      raise ArgumentError, "Unknown predicate type: #{key}"
    end
  end

  def prepare_tasks
    update_box_count
    @local_timers = {}
    # Seed every counter the configured predicates actually name. Neither hash
    # was ever assigned, and Lich's NilClass patch turns `nil['key'] > 0` and a
    # bare `nil` into falsy rather than an error, so both predicates read false
    # forever and any task gated on one never started.
    @hunt_counters = {}
    @first_run_counters = {}
    all_tasks.each do |task|
      terminal_predicates(task).each do |predicate|
        case predicate.keys.first
        when 'after_every_hunt'
          @hunt_counters[predicate['after_every_hunt']['key']] = 0
        when 'on_first_run'
          @first_run_counters[predicate['on_first_run']['key']] = true
        end
      end
    end
    @cleanup_tasks.each { |task| task[:marked] = !task[:skip_first_run] }
  end

  def all_tasks
    @cleanup_tasks + @hunting_tasks + @town_tasks
  end

  def task_list(key, type)
    tasks = @settings.send(key)
    # None of the three keys exists in base.yaml or in base-empty.yaml's
    # coercion map, so an unconfigured character resolves all three to nil.
    # Lich's NilClass patch makes `nil.each` a no-op, so the script used to
    # walk to safe_room, start afk and pause forever without reporting
    # anything wrong. Refuse to start instead.
    raise ArgumentError, "#{key} must be a list of tasks" unless tasks.nil? || tasks.is_a?(Array)
    Array(tasks).each { |task| task[:type] = type }
  end

  # A child started through DRC.wait_for_script_to_complete outlives this
  # script when the coordinator is killed mid-task, so record which one is in
  # flight for before_dying to stop. Town tasks may name any script, so the
  # name cannot be known from a fixed list.
  attr_reader :child_script

  def wait_for_child(script, args = [])
    @child_script = script
    DRC.wait_for_script_to_complete(script, args)
  ensure
    @child_script = nil
  end

  def terminal_predicates(task)
    predicates = []
    (predicates << task[:start_on]) if task[:start_on]
    (predicates << task[:stop_on]) if task[:stop_on]
    predicates.map { |pred| terminal_predicates_helper(pred) }.flatten
  end

  def terminal_predicates_helper(predicate)
    return [] if predicate.nil? || predicate.empty?
    unless predicate.size == 1
      raise ArgumentError, "Predicate with multiple keys: #{predicate}"
    end

    key = predicate.keys.first
    value = predicate[key]
    case key
    when 'or', 'and'
      value.map { |member| terminal_predicates_helper(member) }.flatten
    else
      [predicate]
    end
  end

  def get_timers(task)
    terminal_predicates(task).select { |pred| pred.keys.first == 'timer' }
                             .map { |pred| pred['timer'] }
  end

  def update_predicates_for_completed_task(task)
    if task[:type] == :cleanup
      task[:marked] = false
    elsif task[:type] == :hunting && !task[:no_cleanup]
      @cleanup_tasks.each { |task| task[:marked] = true }
    end
    @hunt_counters.each_key { |key| @hunt_counters[key] += 1 } if task[:type] == :hunting
    terminal_predicates(task).each do |predicate|
      case predicate.keys.first
      when 'after_every_hunt'
        @hunt_counters[predicate['after_every_hunt']['key']] = 0
      when 'on_first_run'
        @first_run_counters[predicate['on_first_run']['key']] = false
      end
    end
    get_timers(task).each { |timer| reset_timer(timer) }
  end

  def reset_timer(timer)
    reset_time = Time.now + timer['time']
    if timer['global']
      echo("Resetting global timer: #{timer}") if @debug
      UserVars.coordinator_timers[timer['key']] = reset_time
    else
      echo("Resetting local timer: #{timer}") if @debug
      @local_timers[timer['key']] = reset_time
    end
  end

  def get_time(timer)
    if timer['global']
      UserVars.coordinator_timers[timer['key']] || (Time.now - 1)
    else
      @local_timers[timer['key']] || (Time.now - 1)
    end
  end

  def skill_less_than?(skill, target)
    echo("Skill level is #{DRSkill.getxp(skill)}") if @debug
    DRSkill.getxp(skill) < target
  end

  def skill_greater_than?(skill, target)
    echo("Skill level is #{DRSkill.getxp(skill)}") if @debug
    DRSkill.getxp(skill) > target
  end

  def rank_less_than?(skill, target)
    echo("Skill rank is #{DRSkill.getrank(skill)}") if @debug
    DRSkill.getrank(skill) < target
  end

  def rank_greater_than?(skill, target)
    echo("Skill rank is #{DRSkill.getrank(skill)}") if @debug
    DRSkill.getrank(skill) > target
  end

  def update_box_count
    @num_boxes = DRCI.count_all_boxes(@settings)
  end

  def run_idle_task
    if @safe_idle
      raise "safe_idle requires the observed configured safe room #{@settings.safe_room}" unless Room.current && Room.current.id == @settings.safe_room
    else
      DRCT.walk_to @settings.safe_room
    end
    # Upstream starts `afk` here. Under drbot the resident watchdog already
    # owns anti-idle keepalive and contains automation before the game's final
    # idle warning, so a second idle writer is duplicate game traffic from a
    # script no profile policy reviews. Idling in the safe room is enough.
    $DRBOT_COORDINATOR_IDLE = Script.current
    pause 60
  ensure
    $DRBOT_COORDINATOR_IDLE = nil
  end

  def run_town_task(task)
    echo("Running town task #{task}") if @debug
    safe_room = @settings.safe_room
    pause_script('sanowret-crystal') if task[:pause_sanowret]
    if task[:walk_to]
      case task[:walk_to]
      when 'safe_room'
        DRCT.walk_to(safe_room)
      else
        DRCT.walk_to(task[:walk_to])
      end
    end
    wait_for_child('buff', [task[:buff]]) if task[:buff]
    if task[:town] && DRStats.necromancer?
      wait_for_child('release-necro')
    end
    if (action = task[:action])
      unless all_actions.include? action
        raise ArgumentError, "Action not in whitelist: #{action}"
      end

      send(action, task)
    elsif (script = task[:script])
      play_song?(false) if task[:play_song]
      child = wait_for_child(script, task[:args])
      if child.respond_to?(:drbot_remedy_unavailable) && child.drbot_remedy_unavailable.is_a?(String) && !child.drbot_remedy_unavailable.empty?
        task[:retry_after] = Time.now + 600
        echo "***STATUS*** Town task #{task_label(task)} unavailable (#{child.drbot_remedy_unavailable}); retry delayed 600 seconds"
      end
      note_box_handoff_result(child.drbot_box_handoff_result) if child.respond_to?(:drbot_box_handoff_result)
      stop_play if task[:play_song]
    else
      raise ArgumentError, "Expected action or script: #{task}"
    end
    unpause_script('sanowret-crystal') if task[:pause_sanowret]
  end

  # A box handoff child (drbot-gbox, lanjefast-collect-boxes) publishes its
  # verified result. The box count is otherwise refreshed only at start, after
  # a hunt and after pick_boxes, so a boxes_over/boxes_under gate never saw a
  # collection. While Grimdur drains his vault (~90 boxes, 2026-09-26) he says
  # "vault draining for Lanjefast" before each vault box, and the collector
  # reports it as keeper_draining. That latches vault_draining? for 30 minutes
  # so the collect/pick town tasks run ahead of the default hunt; any other
  # handoff result (a skip, a failure, a collection without the line) clears
  # it and the hunt resumes.
  VAULT_DRAIN_LATCH_SECONDS = 1800

  def note_box_handoff_result(result)
    result = {} unless result.is_a?(Hash)
    count = result['count']
    collected = count.is_a?(Integer) && count.positive?
    update_box_count if collected
    if collected && result['keeper_draining'] == true
      @drain_until = Time.now + VAULT_DRAIN_LATCH_SECONDS
      echo '***STATUS*** vault drain latched'
    elsif @drain_until
      @drain_until = nil
      echo '***STATUS*** vault drain cleared'
    end
  end

  def run_hunting_task(task)
    file = task[:file]
    echo("Starting hunting-buddy with file #{file}") if @debug
    pause_script('sanowret-crystal') if task[:pause_sanowret]
    hunt_started = Time.now
    start_script('hunting-buddy', [file])
    pause 5
    next_check = Time.now + 60
    while Script.running?('hunting-buddy')
      if Time.now > next_check
        $HUNTING_BUDDY.stop_hunting if task[:stop_on] && evaluate_predicate?(task[:stop_on])
        next_check = Time.now + 60
      end
      pause 5
    end
    hunt_seconds = (Time.now - hunt_started).to_i
    update_box_count
    defer_box_blocked_hunt(task, hunt_seconds)
    safe_room = @settings.safe_room
    safe_room = task[:safe_room]['id'] if task[:safe_room]
    DRCT.walk_to(safe_room)
    unpause_script('sanowret-crystal') if task[:pause_sanowret]
    # SetupProcess records a single unresolved result if its cleanup stow was
    # refused. Return to the safe room, then suppress task completion and all
    # later tasks until an operator reconciles, clears the hold, and restarts
    # this coordinator (which retains @task_hold for its current run).
    if (custody_hold = UserVars.drbot_weapon_custody_hold).is_a?(Hash)
      @task_hold = custody_hold['reason'] || 'weapon custody unresolved; operator reconciliation required'
      UserVars.coordinator_safety_hold = custody_hold
    elsif (custody_hold = UserVars.drbot_custody_hold).is_a?(Hash)
      @task_hold = custody_hold['reason'] || 'custody unresolved; operator reconciliation required'
      UserVars.coordinator_safety_hold = custody_hold
    end
  end

  # hunting-buddy skips a hunt while more boxes are held than
  # box_hunt_minimum, and combat-trainer stops one at box_loot_limit. With the
  # cleanup handoff declined ('DRBOT GBOX SKIPPED: keeper did not confirm
  # readiness'), re-selecting the default hunt looped short hunts and handoff
  # walks for hours: Vrakk 2026-09-26 00:30-02:40 and 09:17-09:54 logged 78
  # 'Stopping hunt because have enough boxes' (15-60 second hunts), Thargrund
  # 02:03:03 'Skipping hunt because have enough boxes' (5-10 second hunts).
  # A short hunt that ends with those gates still full defers the next hunt
  # so town tasks, then the safe-room idle, run instead; the cleanup chain
  # still gets its one handoff attempt after every hunt.
  BOX_BLOCKED_HUNT_SECONDS = 180
  BOX_BLOCKED_RETRY_SECONDS = 600

  def hunt_boxes_full?(task = nil)
    return false unless @num_boxes.is_a?(Integer)

    minimum = @settings.box_hunt_minimum
    limit = @settings.box_loot_limit
    if limit == 0
      # Zero disables box looting, but only a hunt with `boxes: true` can
      # actually stop on that limit. `boxes: false` hunts must not back off,
      # even when the picker carries boxes from the keeper's backlog.
      file = task && task[:file]
      hunt_settings = file && file != 'setup' ? get_settings([file]) : @settings
      infos = Array(hunt_settings.hunting_info)
      return false unless infos.any? { |info| info['boxes'] || info['stop_on_boxes'] }
    end
    (minimum.is_a?(Integer) && @num_boxes > minimum) || (limit.is_a?(Integer) && @num_boxes >= limit)
  end

  def defer_box_blocked_hunt(task, hunt_seconds)
    return unless hunt_seconds < BOX_BLOCKED_HUNT_SECONDS && hunt_boxes_full?(task)

    task[:retry_after] = Time.now + BOX_BLOCKED_RETRY_SECONDS
    task[:box_recount_pending] = true
    echo "***STATUS*** Hunt #{task_label(task)} ended after #{hunt_seconds} seconds holding #{@num_boxes} boxes " \
         "(box_hunt_minimum #{@settings.box_hunt_minimum.inspect}, box_loot_limit #{@settings.box_loot_limit.inspect}); " \
         "next hunt delayed #{BOX_BLOCKED_RETRY_SECONDS} seconds"
  end

  #
  # Predicates
  #

  def all_predicates
    [
      'hunt_done?',
      'run_crossing_training?',
      'vault_draining?'
    ]
  end

  def hunt_done?
    # TODO: would be nice to not have to double-check predicates here.
    !hunting_task
  end

  def run_crossing_training?
    @settings.crossing_training.any? { |skill| DRSkill.getxp(skill) < 28 }
  end

  # Latched by note_box_handoff_result; lapses on its own after 30 minutes.
  def vault_draining?
    !@drain_until.nil? && Time.now < @drain_until
  end

  #
  # Actions
  #
  def all_actions
    %w[
      pick_boxes
      train_performance
      train_outfitting
      train_engineering
      train_forging
      train_alchemy
      crossing_training
      infuse_osrel
      check_favors
    ]
  end

  def pick_boxes(task)
    DRCT.walk_to(@settings.lockpick_room_id) if @settings.lockpick_room_id
    if @settings.waggle_sets['locksmithing']
      wait_for_child('buff', ['locksmithing'])
    end
    before_count = @num_boxes
    wait_for_child('pick')
    update_box_count
    if before_count && @num_boxes && @num_boxes >= before_count && @num_boxes > 0
      task[:retry_after] = Time.now + 600
      echo "***STATUS*** Box picking made no progress (#{@num_boxes} remaining); retry delayed 600 seconds"
    end
  end

  def infuse_osrel(task)
    if @settings.osrel_amount && DRSpells.active_spells['Osrel Meraud']
      DRCA.infuse_om(!@settings.osrel_no_harness, @settings.osrel_amount)
    else
      echo '***OM IS DOWN OR NO osrel_amount***'
      task[:deleted] = true
    end
  end

  def check_favors(_task)
    return unless @settings.favor_goal

    /(\d+)/ =~ DRC.bput('favor', 'You currently have \d+', 'You are not currently')
    favor_count = Regexp.last_match(1).to_i
    return if favor_count >= @settings.favor_goal

    if /could not/ =~ DRC.bput("tap my #{@settings.favor_god} orb", 'The orb is delicate', 'I could not find')
      wait_for_child('favor')
      fput('stow my orb')
    elsif rub_orb?
      DRCT.walk_to(5865)
      fput("get my #{@settings.favor_god} orb")
      fput('put my orb on altar')
      if favor_count + 1 < @settings.favor_goal
        wait_for_child('favor')
        fput('stow my orb')
      end
    end
  end

  def rub_orb?
    case DRC.bput("rub my #{@settings.favor_god} orb", 'not yet fully prepared', 'lacking in the type of sacrifice the orb requires', 'your sacrifice is properly prepared')
    when 'not yet fully prepared'
      false
    when 'lacking in the type of sacrifice the orb requires'
      false
    when 'your sacrifice is properly prepared'
      true
    end
  end

  def train_performance(task)
    return if play_song?(true)

    echo '***UNABLE TO TRAIN PERFORMANCE, REMOVING IT FROM THE TRAINING LIST***'
    task[:deleted] = true
  end

  def train_outfitting(_task)
    wait_for_child('workorders', ['Tailoring'])
    wait_for_child('sell-loot')
  end

  def train_alchemy(_task)
    wait_for_child('workorders', ['Remedies'])
    wait_for_child('sell-loot')
  end

  def train_engineering(_task)
    wait_for_child('workorders', ['Shaping'])
    wait_for_child('sell-loot')
  end

  # drf (drg-1ku, drg-9yh): the fail-closed runner (workorders_resume_or_request)
  # publishes drbot_workorders_result on its Script handle. A turn-in or one of
  # the benign no-spend exits lets sell-loot bank the pass as before. Anything
  # else -- a forge or bundle failure after an ingot was bought, a preflight
  # block, a missing result, or the train_forging_deadline_seconds bound --
  # holds the schedule where it stands and records UserVars.drbot_forging_hold,
  # which keeps train_forging from running again, across restarts, until an
  # operator reconciles and clears it. Before this latch every later pass
  # resumed the order and bought another ingot before forging failed again.
  FORGING_BENIGN_RESULTS = %w[turned_in no_suitable_offer master_not_found kept_unadmitted kept_short_time mindstate turnin_retry confirm_mismatch].freeze
  # What workorders starts on its own and leaves running when it is killed.
  FORGING_GRANDCHILDREN = %w[smith forge go2].freeze

  def train_forging(_task)
    unless @settings.workorders_resume_or_request
      wait_for_child('workorders', ['Blacksmithing'])
      wait_for_child('sell-loot')
      return
    end

    child, failure = run_forging_child
    result = child.respond_to?(:drbot_workorders_result) ? child.drbot_workorders_result : nil
    status = result.is_a?(Hash) ? result['status'].to_s : nil
    if failure.nil? && FORGING_BENIGN_RESULTS.include?(status)
      echo("***STATUS*** train_forging: workorders #{status} (#{result['detail']})")
      wait_for_child('sell-loot')
      return
    end

    latch_forging(failure || (status ? "workorders #{status}: #{result['detail']}" : 'workorders published no result'))
  end

  def run_forging_child
    return [nil, 'workorders was already running; not started'] if Script.running?('workorders')

    @child_script = 'workorders'
    child = start_script('workorders', ['Blacksmithing'])
    return [nil, 'workorders start unconfirmed'] unless child

    limit = @settings.train_forging_deadline_seconds
    deadline = limit.is_a?(Integer) && limit.positive? ? Time.now + limit : nil
    while Script.list.any? { |candidate| candidate.equal?(child) }
      if deadline && Time.now >= deadline
        stop_forging_family(child)
        return [nil, "workorders exceeded #{limit} seconds; stopped with smith, forge and go2, custody unconfirmed"]
      end
      pause 0.5
    end
    [child, nil]
  ensure
    @child_script = nil
  end

  def stop_forging_family(child)
    begin
      child.kill if Script.list.any? { |candidate| candidate.equal?(child) }
    rescue StandardError
      nil
    end
    FORGING_GRANDCHILDREN.each { |name| stop_script(name) if Script.running?(name) }
  end

  def latch_forging(detail)
    reason = "train_forging stopped (#{detail}); reconcile the forging logbook, ingots, coins and hands, " \
             'then clear UserVars.drbot_forging_hold'
    record = { 'reason' => reason, 'since' => Time.now.to_f }
    record['persistence_unconfirmed'] = true unless persist_forging_hold(record)
    UserVars.drbot_forging_hold = record
    @task_hold = reason
    UserVars.coordinator_safety_hold = record
    echo("***COORDINATOR HOLD*** #{reason}")
  end

  # Vars.save can cache its digest before SQL succeeds; verify the stored
  # character-scoped record, as combat-trainer does for its custody hold.
  def persist_forging_hold(record)
    UserVars.drbot_forging_hold = record
    Vars.save
    persisted = Lich.db_mutex.synchronize do
      blob = Lich.db.get_first_value('SELECT hash FROM uservars WHERE scope=?;',
                                     ["#{XMLData.game}:#{XMLData.name}".encode('UTF-8')])
      blob && Marshal.load(blob)['drbot_forging_hold']
    end
    persisted == record
  rescue StandardError
    false
  end

  def forging_latched?
    hold = UserVars.drbot_forging_hold
    return false unless hold.is_a?(Hash)

    unless @forging_latch_reported
      @forging_latch_reported = true
      echo("***STATUS*** train_forging skipped until UserVars.drbot_forging_hold is cleared: #{hold['reason']}")
    end
    true
  end

  def crossing_training(task)
    @child_script = 'crossing-training'
    unless start_script('crossing-training')
      @task_hold = 'crossing-training did not start; operator reconciliation required'
      return
    end
    pause 5

    target_skills = @settings.crossing_training.dup
    deadline = Time.now + 900
    stop_requested_at = nil
    settle_hold = nil
    next_hold_echo = nil
    while Script.running?('crossing-training')
      trainer = $CROSSING_TRAINER
      unless trainer && trainer.respond_to?(:training_skills)
        @task_hold = 'crossing-training has no compatible status; operator reconciliation required'
        # A prior settle hold is no longer the reason for this hold. The child
        # is still running, so keep the readable state accurate for operators.
        UserVars.coordinator_safety_hold = { 'reason' => @task_hold, 'since' => Time.now.to_f } if settle_hold
        return
      end
      unavailable = target_skills - trainer.training_skills
      target_skills -= unavailable
      target_skills.reject! { |skill| DRSkill.getxp(skill) >= 28 }
      unless unavailable.empty?
        task[:retry_after] = Time.now + 600
        echo "***STATUS*** Crossing training unavailable: #{unavailable.join(', ')}; retry delayed 600 seconds"
      end
      unless stop_requested_at
        reason = if target_skills.empty?
                   'available target skills complete'
                 elsif task[:stop_on] && evaluate_predicate?(task[:stop_on])
                   'task stop_on predicate met'
                 elsif Time.now >= deadline
                   task[:retry_after] = Time.now + 600
                   '900-second task limit reached'
                 end
        if reason
          trainer.stop
          stop_requested_at = Time.now
          echo "***STATUS*** Crossing training stop requested: #{reason}"
        end
      end
      if stop_requested_at && !settle_hold && Time.now - stop_requested_at >= 120
        # Stops have taken 13-171 seconds to settle (Agondar 2026-09-26: stop
        # requested 03:03:41, child exited 03:06:32 after finishing its climb
        # and walk). A slow settle is still the child's own stop path, so hold
        # the schedule and keep observing it rather than latching. Nothing is
        # killed, re-requested or started meanwhile, and no task is reported
        # or reset; a child that never exits keeps this hold, and its fenced
        # containment, for operator reconciliation.
        settle_hold = 'crossing-training has not settled 120 seconds after stop request; schedule held until it exits'
        UserVars.coordinator_safety_hold = { 'reason' => settle_hold, 'since' => Time.now.to_f }
        next_hold_echo = Time.now
      end
      if settle_hold && Time.now >= next_hold_echo
        echo("***COORDINATOR HOLD*** #{settle_hold}")
        next_hold_echo = Time.now + 60
      end
      pause 5
    end
    if settle_hold
      # The observed exit is the settle evidence; resume like any other stop.
      UserVars.coordinator_safety_hold = nil
      echo "***STATUS*** Crossing training settled #{(Time.now - stop_requested_at).to_i} seconds after stop request; schedule hold cleared"
    end
  ensure
    @child_script = nil unless Script.running?('crossing-training')
  end

  # Harvested wholesale from crossing-training

  def play_song?(blocking = false)
    return false if @no_instrument
    return true if DRSkill.getxp('Performance') >= 28

    UserVars.song = @song_list.first.first unless UserVars.song
    @did_play = true
    case DRC.bput("play #{UserVars.song}",
                  'dirtiness may affect your performance',
                  'slightest hint of difficulty',
                  'You begin a', 'You struggle to begin',
                  'You\'re already playing a song',
                  'You effortlessly begin', 'You begin some',
                  'You cannot play', 'Play on what instrument',
                  'now isn\'t the best time to be playing',
                  'Perhaps you should find somewhere drier before trying to play')
    when 'Play on what instrument'
      @no_instrument = true
      return false
    when 'now isn\'t the best time to be playing',
         'Perhaps you should find somewhere drier before trying to play'
      return true
    when 'You cannot play'
      wait_for_child('safe-room')
    when 'dirtiness may affect your performance'
      if DRSkill.getrank('Performance') < 20
        echo "Skipping cleaning of zills due to low rank of Performance: #{DRSkill.getrank('Performance')}"
        return true
      end
      stop_play
      clean_zills
      return play_song?
    when 'You begin a', 'You effortlessly begin', 'You begin some'
      stop_play
      UserVars.song = @song_list[UserVars.song] || @song_list.first.first
      return play_song?
    when 'You struggle to begin'
      if UserVars.song != @song_list.first.first
        stop_play
        UserVars.song = @song_list.first.first
        return play_song?
      end
    end

    return true unless blocking

    Flags.reset('coord-song')
    pause 1 until Flags['coord-song']
    true
  end

  def stop_play
    return unless @did_play
    return if @no_instrument

    @did_play = false
    DRC.bput('stop play', 'You stop playing your song',
             'In the name of', "But you're not performing")
    Flags['coord-song'] = true
  end

  def clean_zills
    cloth = @settings.cleaning_cloth
    DRC.bput('remove my zills', 'You slide')
    DRC.bput("get my #{cloth}", 'You get')

    loop do
      case DRC.bput("wipe my zills with my #{cloth}", 'Roundtime', 'not in need of drying', 'You should be sitting up')
      when 'not in need of drying'
        break
      when 'You should be sitting up'
        DRC.fix_standing
        next
      end
      pause 1
      waitrt?

      until /you wring a dry/i =~ DRC.bput("wring my #{cloth}", 'You wring a dry', 'You wring out')
        pause 1
        waitrt?
      end
    end

    until /not in need of cleaning/i =~ DRC.bput("clean my zills with my #{cloth}", 'Roundtime', 'not in need of cleaning')
      pause 1
      waitrt?
    end

    DRC.bput('wear my zills', 'You slide')
    DRC.bput("stow my #{cloth}", 'You put')
  end
end

before_dying do
  # Every child this script starts, including the town task in flight. A task
  # started with DRC.wait_for_script_to_complete keeps running when the
  # coordinator is killed.
  ['hunting-buddy', 'crossing-training', $COORDINATOR&.child_script].compact.uniq.each do |script_name|
    stop_script(script_name) if Script.running?(script_name)
  end
  # A killed workorders leaves smith, forge or a walk running (drg-9yh).
  if $COORDINATOR&.child_script == 'workorders'
    Coordinator::FORGING_GRANDCHILDREN.each { |script_name| stop_script(script_name) if Script.running?(script_name) }
  end
  # run_town_task and run_hunting_task pause this on :pause_sanowret and only
  # unpause on the success path, so any crash left it paused indefinitely.
  unpause_script('sanowret-crystal')
  # The matcher registered in the constructor otherwise outlives the script.
  Flags.delete('coord-song')
  UserVars.coordinator_safety_hold = nil
  $COORDINATOR = nil
end

# A crafting child stops when a required item is missing (drg-w12).
#
# dr-scripts' common-crafting.lic ended DRCC.get_crafting_item's missing-item
# branch with `exit unless skip_exit`, and most crafting scripts are written for
# that. The pinned Lich 5.20 port still prints "Cannot continue crafting without
# required item. Stopping script." but then returns nil, so the caller goes on
# without the item. Agondar's remedy child did that for eight hours on
# 2026-09-29: each crush asked for another splash of water, `get my water from
# my purple sack` found none, `put water in my mortar` failed, and the crush
# asked again (375 times between 11:18 and 14:42 alone).
#
# Every crafting script drbot runs is a child of this coordinator, so the
# coordinator restores that contract for its Lich process before the first
# task: once Lich has printed that line, the script whose thread asked for the
# item records it (drbot_crafting_missing_item on its Script handle), logs one
# status line and exits. A call with skip_exit still returns nil.
#
# The methods in checked_callers were rewritten upstream for Lich's nil: right
# after the GET they check the hands, then stow, release crafting magic, log
# and exit themselves (forge's verify_tool_in_hand and cleanup_and_exit, sew's
# and tinker's swap_tool). A call made from one of them keeps its nil, so that
# cleanup runs; the item is still recorded. Lich names each frame of a script
# after the script, so the asking script's first frame names its method.
# Starting the coordinator again replaces the two hook bodies instead of
# stacking them.
module DrfCraftingItemStop
  def self.stop_text
    'DRCC: Cannot continue crafting without required item. Stopping script.'
  end

  def self.checked_callers
    {
      'forge' => %w[get_tool swap_tool prep_with_instructions prep_with_individual_book],
      'sew' => %w[swap_tool],
      'tinker' => %w[swap_tool]
    }
  end

  def self.checks_itself?(script_name, locations)
    methods = checked_callers[script_name]
    return false unless methods

    frame = locations.find { |location| location.path == script_name }
    !frame.nil? && methods.include?(frame.base_label)
  end

  def self.install
    return false unless defined?(Lich::DragonRealms::DRCC) && defined?(Lich::Messaging)

    key = :drf_crafting_item_stop
    stop_text = self.stop_text
    stopper = self
    getter = Module.new do
      define_method(:get_crafting_item) do |name, bag, bag_items, belt, skip_exit = false|
        return super(name, bag, bag_items, belt, skip_exit) if skip_exit

        script = Script.current
        checked = !script.nil? && stopper.checks_itself?(script.name, caller_locations(1))
        asked = Thread.current.thread_variable_get(key) || []
        Thread.current.thread_variable_set(key, asked + [[name, checked]])
        begin
          super(name, bag, bag_items, belt, skip_exit)
        ensure
          Thread.current.thread_variable_set(key, asked)
        end
      end
    end
    messages = Module.new do
      define_method(:msg) do |type = 'info', text = '', **options|
        result = super(type, text, **options)
        name, checked = (Thread.current.thread_variable_get(key) || []).last if text == stop_text
        script = name && Script.current
        if script
          script.define_singleton_method(:drbot_crafting_missing_item) { name }
          unless checked
            echo("***STATUS*** #{script.name} stopped: missing required crafting item #{name}")
            exit
          end
        end
        result
      end
    end
    [[Lich::DragonRealms::DRCC.singleton_class, getter, :get_crafting_item],
     [Lich::Messaging.singleton_class, messages, :msg]].each do |target, hook, method_name|
      installed = target.instance_variable_get(:@drf_crafting_item_stop)
      if installed.is_a?(Module)
        installed.send(:define_method, method_name, hook.instance_method(method_name))
      else
        target.prepend(hook)
        target.instance_variable_set(:@drf_crafting_item_stop, hook)
      end
    end
    true
  end
end

DrfCraftingItemStop.install

Coordinator.new(true)
