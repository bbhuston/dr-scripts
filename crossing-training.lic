=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#crossing-training
=end

class CrossingTraining
  attr_reader :running, :idling

  # The trainer removes unavailable/unfunded skills from its own settings.
  # Expose a copy so the coordinator does not wait on its stale original list.
  def training_skills
    @settings.crossing_training.dup
  end

  def stop
    echo 'Received stop signal' if UserVars.crossing_trainer_debug
    @stop = true
  end

  # Child trainers started by this script poll this predicate so a stop
  # request reaches their own loops. Without it the parent cannot settle
  # until the child's independent attempt budget is exhausted.
  def stopping?
    @stop
  end

  def initialize
    @performance_owner = performance_capture_owner
    @stop = false
    @running = true
    @idling = false
    @cyclic_cycle_timer = Time.now - 300
    arg_definitions = [[]]

    args = parse_args(arg_definitions, true)

    @settings = get_settings(args.flex)
    @worn_trashcan = @settings.worn_trashcan
    @worn_trashcan_verb = @settings.worn_trashcan_verb
    @hometown = @settings.hometown
    @training_room = (@settings.training_rooms || [@settings.safe_room]).sample
    @song_list = get_data('perform').perform_options
    @junk_timer = Time.now
    @pray_to_chadatru = @settings.pray_to_chadatru
    @chadatru_prayer_cooldown = 3600
    @use_tessera = @settings.use_tessera_during_crossing_training
    @tessera_invoke_cooldown = 660
    @use_research = @settings.use_research
    @settings.storage_containers.each { |container| fput("open my #{container}") }
    @disciplines_to_skill = {
      'Blacksmithing'  => 'Forging',
      'Weaponsmithing' => 'Forging',
      'Armorsmithing'  => 'Forging',
      'Tailoring'      => 'Outfitting',
      'Shaping'        => 'Engineering',
      'Carving'        => 'Engineering',
      'Remedies'       => 'Alchemy'
    }
    @skills_requiring_movement = @settings.crossing_training_requires_movement

    @equipment_manager = EquipmentManager.new(@settings)

    UserVars.crossing_timers ||= {}

    if DRStats.paladin?
      UserVars.chadatru_prayer_last ||= Time.now - @chadatru_prayer_cooldown
    elsif DRStats.trader?
      UserVars.tessera_invoke_last ||= Time.now - @tessera_invoke_cooldown
    end

    DRCA.release_cyclics

    Flags.add('ct-song', 'you finish playing')
    # A damaged instrument fails every play exactly like a missing one, and
    # only this flag stops play_song? retrying it. Khazdar's logs hold 126
    # "The bones is much too damaged to play." replies from 2026-09-26 18:39
    # until a repair kit fixed them 2026-09-27 06:14 (drg-8lm).
    Flags.add('ct-no-instrument', 'Play on what instrument', 'too damaged to play')
    Flags.add('ct-damaged-instrument', 'too damaged to play')
    Flags.add('ct-dirty-instrument', 'dirtiness may affect your performance', /^You really need to drain/)
    Flags.add('ct-cleaned-instrument', 'not in need of cleaning')
    Flags.add('research-partial', 'there is still more to learn before you arrive at a breakthrough', 'distracted by combat', 'distracted by your spellcasting', 'You lose your focus on your research project', 'you forget what you were')
    Flags.add('research-complete', '^Breakthrough!')
  end

  def dump_junk
    return unless @settings.dump_junk
    return unless Time.now - @junk_timer > 300
    return unless DRRoom.room_objs.size > @settings.dump_item_count

    DRC.bput('dump junk', 'You should just kick', 'You have marked this room', 'You cannot summon', 'The janitor was recently summoned')
    @junk_timer = Time.now
  end

  def main
    DRCT.walk_to(@training_room)
    loop do
      if @settings.waggle_sets['town-training']
        DRC.wait_for_script_to_complete('buff', ['town-training'])
      end
      event_loop
      if @idling
        pause 30
        @idling = false
      end
      next unless @stop && !@researching

      @running = false
      stop_play
      break
    end
  end

  def empty_trash
    trash_nouns = get_data('items').trash_nouns

    if trash_nouns.any? { |noun| /\b#{noun}/i =~ GameObj.right_hand.noun } && !@equipment_manager.is_listed_item?(DRC.right_hand)
      DRCI.dispose_trash(DRC.right_hand, @worn_trashcan, @worn_trashcan_verb)
    end

    if trash_nouns.any? { |noun| /\b#{noun}/i =~ GameObj.left_hand.noun } && !@equipment_manager.is_listed_item?(DRC.left_hand)
      DRCI.dispose_trash(DRC.left_hand, @worn_trashcan, @worn_trashcan_verb)
    end
    dump_junk
  end

  def event_loop
    empty_trash
    @equipment_manager.empty_hands

    # The next skill to train is the one with the lowest field experience, with
    # equal experience broken by least recently trained. The timer store is not
    # guaranteed to exist yet on the first pass, so read it defensively: a
    # missing store must order the tie, never raise out of the training loop.
    timers = begin
      UserVars.crossing_timers || {}
    rescue NoMethodError
      {}
    end
    skill = @settings.crossing_training
                     .select { |s| ready_to_use?(s) }
                     .select { |s| not_research_blocked?(s) }
                     .reject { |s| @settings.crossing_training_stationary_skills_only && @skills_requiring_movement.include?(s) }
                     .min_by { |s| [DRSkill.getxp(s), (timers[s] || Time.at(0)).to_f] }

    check_tithe
    check_chadatru
    check_tessera

    unless @skills_requiring_movement.include?(skill)
      DRCT.walk_to(@training_room)

      check_listening
      check_teaching
    end

    check_research

    check_osrel unless @researching

    if skill.nil? || skill.empty? || DRSkill.getxp(skill) >= @settings.crossing_training_max_threshold
      if @researching
        echo '***Skills capped and researching***' if UserVars.crossing_trainer_debug
        pause 30
        fput 'research status'
      else
        @idling = true
        echo '***Skills capped, sleeping***' if UserVars.crossing_trainer_debug
        fput 'exit' if @settings.exit_on_skills_capped
        DRCT.walk_to(@training_room)
        play_song?
        fput 'tdp'
      end

      return
    end

    stop_play unless @researching
    refresh_cyclic unless @researching

    echo "***Attempting to train #{skill}***" if UserVars.crossing_trainer_debug

    update_timer(skill)

    case skill
    when 'Appraisal'
      train_appraisal
    when 'Arcana'
      train_arcana
    when 'Athletics'
      train_athletics
    when 'Life Magic', 'Holy Magic', 'Lunar Magic', 'Elemental Magic', 'Arcane Magic'
      do_research skill
    when 'Astrology'
      train_astrology
    when 'Attunement'
      train_attunement
    when 'Augmentation', 'Warding', 'Utility', 'Debilitation'
      train_magic skill
    when 'Empathy'
      train_empathy
    when 'Enchanting'
      train_enchanting
    when 'Engineering'
      train_engineering
    when 'First Aid'
      train_first_aid
    when 'Forging'
      train_forging
    when 'Locksmithing'
      train_locksmithing
    when 'Mechanical Lore'
      warn('*** REMOVED *** Mechanical Lore is no longer supported as it has been removed from the game with the release of Enchanting. Please remove from your training routine.')
      @settings.crossing_training.delete('Mechanical Lore')
      warn('Dependency has \'Engineering\' to train engineering. Mechanical Lore is slow.')
    when 'Outdoorsmanship'
      if @settings.mine_for_outdoorsmanship
        train_mining
      else
        train_outdoorsmanship
      end
    when 'Outfitting'
      train_outfitting
    when 'Perception'
      train_perception
    when 'Performance'
      train_performance
    when 'Scholarship'
      train_scholarship
    when 'Instinct'
      train_scouting
    when 'Sorcery'
      train_sorcery
    when 'Stealth'
      train_stealth
    when 'Summoning'
      train_summoning
    when 'Theurgy'
      train_theurgy
    when 'Thievery'
      train_thievery
    when 'Trading'
      train_trading
    when 'Alchemy'
      train_alchemy
    else
      echo "#{skill} not implemented yet"
      pause 15
    end
  end

  def check_nerves
    wounds = DRCH.check_health['wounds']
    return unless wounds.values.flatten.map(&:body_part).map(&:downcase).include?('skin')

    DRC.wait_for_script_to_complete('safe-room', ['force'])
    DRCT.walk_to(@training_room)
  end

  def refresh_cyclic
    return unless @settings.cyclic_training_spells
    return unless Time.now - @cyclic_cycle_timer > 300

    cyclic_skill = @settings.cyclic_cycle_skills
                            .min_by { |s| DRSkill.getxp(s) }

    if DRSkill.getxp(cyclic_skill) >= 32
      DRCA.release_cyclics
      return
    end

    cast_spell(@settings.cyclic_training_spells[cyclic_skill], cyclic_skill)
    check_nerves
    @cyclic_cycle_timer = Time.now
  end

  def check_tithe
    return unless @settings.tithe
    return unless (almsbox = @settings.tithe_almsbox || get_data('town')[@hometown]['almsbox']['id'])

    delta = Time.now - (UserVars.tithe_timer || Time.now - 14_400)
    return if (delta < 4 * 60 * 60 && DRStats.paladin?) || (delta < 60 * 10 && DRStats.cleric?)

    currency = DRCM.hometown_currency(@hometown)
    return unless DRCM.withdraw_exact_amount?('5 silver', @settings)

    DRC.wait_for_script_to_complete('pay-debt')

    UserVars.tithe_timer = Time.now
    DRCT.walk_to(almsbox)
    DRC.bput("put 5 silver #{currency} in almsbox", 'You drop', 'But you do not', 'attend to thy own woes')
  end

  def check_chadatru
    return unless DRStats.paladin? && @pray_to_chadatru
    return unless Time.now - UserVars.chadatru_prayer_last > @chadatru_prayer_cooldown

    altar_loc = get_data('theurgy')[@hometown]['chadatru_altar']['id']
    if altar_loc.nil?
      echo "***CHADATRU PRAYER SUPPORT NOT YET IMPLEMENTED IN #{@hometown}, REMOVING CHADATRU PRAYER***"
      @pray_to_chadatru = false
      return
    end

    DRCT.walk_to(altar_loc)

    DRC.bput('kneel', 'You kneel', 'You are already', 'You rise')
    case DRC.bput('pray chadatru', 'As you kneel', 'decide it would be inappropriate')
    when 'As you kneel'
      waitfor('soothing sensation washes over your soul')
    end

    UserVars.chadatru_prayer_last = Time.now
  end

  def check_tessera
    return unless DRStats.trader? && @use_tessera
    return unless Time.now - UserVars.tessera_invoke_last > @tessera_invoke_cooldown

    DRC.retreat
    return unless /inside your (.*)\./ =~ DRC.bput("get my tessera", 'You get a .+ tessera from inside your (.*).', 'What were you')

    container = DRC.get_noun(Regexp.last_match(1))
    DRC.bput('Ask my tessera about invest', 'You send your')
    DRC.bput("put my tessera in my #{container}", 'You put', 'What were you')
    DRCI.stow_hand('left') if DRC.left_hand.include?('tessera')
    DRCI.stow_hand('right') if DRC.right_hand.include?('tessera')

    UserVars.tessera_invoke_last = Time.now
  end

  def train_sorcery
    return if @researching

    unless @settings.crossing_training_sorcery || (DRCI.exists?('runestone') && DRSkill.getrank('Sorcery') <= 50)
      echo '***UNABLE TO TRAIN SORCERY, REMOVING IT FROM THE TRAINING LIST***'
      @settings.crossing_training.delete('Sorcery')
      return
    end

    DRC.wait_for_script_to_complete('sorcery')
  end

  def check_teaching
    return unless @settings.classes_to_teach
    return if @settings.classes_to_teach.empty?
    return if @last_teacher

    if @class_timer.nil? || Time.now - @class_timer > 10 * 60
      @settings.classes_to_teach.rotate!
      DRC.bput('stop teach', 'You stop', 'you aren\'t teaching')
      pause
      @class_timer = Time.now
    end

    to_teach = @settings.classes_to_teach.first
    DRRoom.pcs.each { |character| DRC.bput("teach #{to_teach} to #{character}", 'You begin to', 'is already listening to you', 'is listening to someone else', 'I could not find who you were referring to', 'You have already offered', 'That person is too busy teaching', 'You are already teaching', 'You cannot teach two different classes at the same time', 'is not paying attention to you', 'You cannot listen to a teacher and teach', 'already trying to teach you something') }
  end

  def check_listening
    return unless @settings.listen
    return if DRC.listen?(@last_teacher, @settings.listen_observe)
    return if DRRoom.pcs.empty?
    return unless @listen_timer.nil? || Time.now - @listen_timer > 5 * 60
    return unless @class_timer.nil?

    classes = DRC.assess_teach
    @last_teacher = classes
                    .reject { |t, s| t.nil? || s.nil? }
                    .sort_by { |_t, s| [DRSkill.getxp(s), DRSkill.getrank(s)] }
                    .find { |t, _s| DRC.listen?(t, @settings.listen_observe) }
                    .first

    @listen_timer = @last_teacher ? nil : Time.now
  end

  def train_summoning
    DRCS.summon_weapon
    DRCS.break_summoned_weapon(DRC.right_hand)
    # Use any remaining elemental charge to train Summoning
    fput('pathway focus damage') if DRStats.circle >= 4
  end

  def train_locksmithing
    return if @researching

    DRC.wait_for_script_to_complete('burgle', ['start']) if @settings.train_with_burgle
    return if DRSkill.getxp('Locksmithing') >= 30

    if @settings.lockpick_room_id
      DRCT.walk_to(@settings.lockpick_room_id)
    else
      DRCT.walk_to(@training_room)
    end

    start_time = Time.now
    DRC.wait_for_script_to_complete('locksmithing')

    if Time.now - start_time > 15
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
    end
  end

  def train_theurgy
    DRC.wait_for_script_to_complete('theurgy')
    return unless @researching
    return if fput('research status', 'not researching anything', 'Fundamental', 'Augmentation', 'Stream', 'Sorcery', 'Utility', 'Warding') != 'not researching anything'

    Flags.reset('research-partial')
    Flags.reset('research-complete')
    @researching = nil
  end

  def train_mining
    return if @researching

    DRC.wait_for_script_to_complete('mining-buddy')
  end

  def handle_cyclic_timers(skill)
    return unless @settings.training_spells[skill]['cyclic']

    other_cyclics = @settings.training_spells.keys.select { |x| x != skill && @settings.training_spells[x]['cyclic'] }
    other_cyclics.each { |type| update_timer(type) }
    (other_cyclics + [skill]).each { |type| @settings.exp_timers[type] = 300 } # Only needs to be done once in setup, but meh.
  end

  def train_magic(skill)
    if @settings.train_with_spells
      if @use_research && @settings.research_skills.include?(skill)
        do_research(skill)
      else
        return if mana < 40

        handle_cyclic_timers(skill)
        cast_spell(@settings.training_spells[skill], skill)
        check_nerves
      end
    else
      cast_nonspell(skill)
    end
  end

  def not_research_blocked?(skill)
    return true unless @use_research
    return (['Summoning', 'Attunement', 'Athletics', 'Outdoorsmanship', 'Perception', 'Appraisal', 'Empathy', 'Mechanical Lore', 'Theurgy'] - @settings.research_skills).include?(skill) if @researching

    research = @settings.research_skills.include?(skill)
    return true unless research
    return DRSkill.getxp(skill) < 18 if ['Life Magic', 'Holy Magic', 'Lunar Magic', 'Elemental Magic', 'Arcane Magic', 'Arcana'].include?(skill)
    return DRSkill.getxp(skill) < 9 if %w[Warding Utility Augmentation Attunement].include?(skill)

    echo("You have #{skill} listed as a research skill, which is not a valid research option")
    true
  end

  def ready_to_use?(skill)
    return true unless UserVars.crossing_timers[skill]

    (Time.now - UserVars.crossing_timers[skill]) > get_skill_timer(skill)
  end

  def get_skill_timer(skill)
    info = @settings.exp_timers[skill]
    return 14 if info.nil?

    info.is_a?(Hash) ? info['cooldown'] : info.to_i
  end

  def update_timer(skill)
    UserVars.crossing_timers[skill] = Time.now
  end

  def cast_nonspell(skill)
    ability = @settings.training_nonspells[skill]
    echo("using ability: #{ability}") if UserVars.crossing_trainer_debug
    if ability.include?('Khri')
      DRCA.activate_khri?(@settings.kneel_khri, ability)
    elsif ability.include?('berserk')
      fput ability
      fput 'berserk stop'
    else
      fput ability
    end
  end

  def map_cambrinth(settings)
    [settings.cambrinth, settings.cambrinth_cap, settings.stored_cambrinth]
  end

  def check_osrel
    return unless @settings.osrel_amount && DRSpells.active_spells['Osrel Meraud']
    return if @last_check_osrel && @last_check_osrel + 120 > Time.now

    @last_check_osrel = Time.now
    DRCA.infuse_om(!@settings.osrel_no_harness, @settings.osrel_amount)
  end

  def research
    refresh_cyclic
    return if DRC.bput("research #{@researching} 300", 'You focus', 'You tentatively', 'You confidently', 'Abandoning the normal', 'You cannot begin') != 'You cannot begin'

    fput('research cancel')
    fput('research cancel')
    research
  end

  def check_research
    return unless @researching

    if Flags['research-partial']
      Flags.reset('research-partial')
      check_osrel
      research
    elsif Flags['research-complete']
      Flags.reset('research-complete')
      @researching = nil
    end
  end

  def do_research(skill)
    unless @use_research
      echo "Tried to use spell research to train #{skill} with it disabled, please correct YAML."
      return
    end

    return if @stop

    Flags.reset('research-partial')
    Flags.reset('research-complete')

    until DRSpells.active_spells['Gauge Flow'] > 20
      cast_spell({ 'abbrev' => 'GAF' }, nil)
      check_nerves
      pause 2
    end
    @researching = case skill
                   when 'Arcana', 'Life Magic', 'Holy Magic', 'Lunar Magic', 'Elemental Magic', 'Arcane Magic'
                     'FUNDAMENTAL'
                   when 'Attunement'
                     'STREAM'
                   else
                     skill.upcase
                   end
    research
  end

  def cast_spell(data, skill)
    data = DRCA.check_discern(data, @settings)
    if data['abbrev'] =~ /^comp/i
      DRCT.walk_to @settings.compost_room
      return unless DRRoom.npcs.empty?

      fput(['\'Had this been a real compost your belongings would be gone. Composting soon', '\'Compost', '\'Compost incoming', '\'This is a code green, compost alert', '\'Pick up your valuables, compost time', '\'If it\'s on the ground it\'s gone, Compost incoming'].sample)
    end

    if (data['abbrev'] =~ /locat/i) && !DRSpells.active_spells['Clear Vision']
      fput('prep cv')
      pause 5
      DRCA.cast?
    end

    if data['moon']
      # Look for a moon that will be up for the next few minutes
      DRCMM.check_moonwatch
      unless DRCMM.set_moon_data(data)
        weather = DRC.bput('weather', 'inside', 'You glance up at the sky.')
        DRCT.walk_to @settings.outdoor_room if weather =~ /inside/
        fput('perceive moons')
        # Look for a moon that will be up for the next few minutes
        return unless DRCMM.set_moon_data(data)
      end
      data = DRCMM.set_moon_data(data)
    end

    DRCA.release_cyclics if data['cyclic']

    custom_prep = data['custom_prep'] || @settings['custom_spell_prep']
    return unless DRCA.prepare?(data['abbrev'], data['mana'], data['symbiosis'], 'prepare', false, nil, false, custom_prep)

    unless @settings.cambrinth_items[0]['name']
      @settings.cambrinth_items = [{
        'name'   => @settings.cambrinth,
        'cap'    => @settings.cambrinth_cap,
        'stored' => @settings.stored_cambrinth
      }]
    end
    @settings.cambrinth_items.each_with_index do |item, index|
      if data['cambrinth'][index][0]
        DRCA.find_charge_invoke_stow(item['name'], item['stored'], item['cap'], @settings.dedicated_camb_use, data['cambrinth'][index], @settings.cambrinth_invoke_exact_amount)
      end
    end
    waitcastrt?

    snapshot = DRSkill.getxp(skill) if data['symbiosis']

    success = DRCA.cast?(data['cast'], data['symbiosis'], data['before'], data['after'])

    return unless data['symbiosis']

    start = Time.now
    pause 0.5 until snapshot != DRSkill.getxp(skill) || Time.now - start > 10 || !success
    if !success
      UserVars.discerns[data['abbrev']]['more'] = [UserVars.discerns[data['abbrev']]['more'] - 1, 0].max
    elsif DRSkill.getxp(skill) - snapshot < @settings.symbiosis_learning_threshold
      UserVars.discerns[data['abbrev']]['more'] = UserVars.discerns[data['abbrev']]['more'] + 1
    end
  end

  def train_performance
    return if play_song?(true)

    echo '***UNABLE TO TRAIN PERFORMANCE, REMOVING IT FROM THE TRAINING LIST***'
    @settings.crossing_training.delete('Performance')
  end

  def train_outdoorsmanship
    return if @researching && @settings.crafting_training_spells

    DRCT.walk_to(@training_room)
    DRC.wait_for_script_to_complete('outdoorsmanship')
  end

  def train_perception
    return if @researching && @settings.crafting_training_spells

    DRCT.walk_to(@training_room)
    DRC.wait_for_script_to_complete('outdoorsmanship', ['perception'])
  end

  def train_first_aid
    if @settings.fa_skinning_trainer
      DRC.wait_for_script_to_complete('faskinner')
    end
    return unless DRSkill.getxp('First Aid') < 30

    before_xp = defined?(DRSkill) ? DRSkill.getxp('First Aid').to_i : 0
    DRC.wait_for_script_to_complete('first-aid')
    if defined?(DRSkill) && DRSkill.getxp('First Aid').to_i <= before_xp
      echo('First Aid trainer made no XP progress, removing First Aid from training')
      @settings.crossing_training&.delete('First Aid')
    end
  end

  def train_scholarship
    play_song?

    if @hometown == 'Crossing' && !DRStats.necromancer?
      DRC.wait_for_script_to_complete('study-art', ['scholarship'])
      return
    end

    case DRC.bput('get my blacksmithing book', 'What were you', 'You get')
    when 'What were you'
      echo '***UNABLE TO TRAIN SCHOLARSHIP, REMOVING IT FROM THE TRAINING LIST***'
      @settings.crossing_training.delete('Scholarship')
      return
    end

    fput('turn my book to chapter 6')
    14.times do |count|
      DRC.bput("turn my book to page #{count + 1}", 'You turn your book to page', 'You are already on')
      DRC.bput('study my book', 'roundtime')
      waitrt?
      break if DRSkill.getxp('Scholarship') >= 30
    end
    fput 'stow my book'
  end

  def train_athletics
    return if @researching

    DRC.wait_for_script_to_complete('burgle', ['start']) if @settings.train_with_burgle
    return if DRSkill.getxp('Athletics') >= 30

    child = DRC.wait_for_script_to_complete('athletics')
    reason = child.drbot_athletics_unavailable if child.respond_to?(:drbot_athletics_unavailable)
    return unless reason.is_a?(String) && !reason.empty?

    # Without this removal the lowest-XP selector immediately starts the same
    # explicitly impossible climb again. This copy lasts only for this
    # trainer pass; coordinator observes it through training_skills and gives
    # other work a turn before a later bounded retry.
    @settings.crossing_training.delete('Athletics')
    echo "***STATUS*** Athletics unavailable for this crossing-training pass: #{reason}"
  end

  def train_empathy
    if (DRSkill.getrank('Empathy') + DRSkill.getrank('Attunement')) / 2 < 75
      echo '***UNABLE TO TRAIN EMPATHY DUE TO LOW RANK, REMOVING IT FROM THE TRAINING LIST***'
      @settings.crossing_training.delete('Empathy')
      return
    end

    room_list = get_data('town')[@hometown]['perceive_health_rooms']
    room_list.each do |room_id|
      DRCT.walk_to(room_id)
      5.times do
        break if DRC.bput('perceive health', 'You fail to sense', 'You sense:', 'You\'re not ready to do that again, yet') == 'You sense:'

        pause 1
        pause 5 unless waitrt?
        check_research
      end
      waitrt?
      break if DRSkill.getxp('Empathy') >= 30
    end
  end

  def train_scouting
    DRC.wait_for_script_to_complete('scouting')
  end

  def train_attunement
    if @use_research && @settings.research_skills.include?('Attunement')
      do_research('Attunement')
      return
    end

    DRC.wait_for_script_to_complete('attunement')
  end

  def hide_in(room_number)
    DRCT.walk_to room_number
    DRC.hide?
    fput 'unhide'
    waitrt?
  end

  def train_stealth
    return if @researching

    DRC.wait_for_script_to_complete('burgle', ['start']) if @settings.train_with_burgle
    return if DRSkill.getxp('Stealth') >= 30 || DRSkill.getrank('Stealth') >= 30

    hide_in 851
    hide_in 850
    hide_in 764
    hide_in 5992
    hide_in 992
  end

  def train_thievery
    return if @researching

    DRC.wait_for_script_to_complete('burgle', ['start']) if @settings.train_with_burgle
    return if DRSkill.getxp('Thievery') >= 30

    stop_play if @settings.hide_to_steal
    DRC.wait_for_script_to_complete('steal')
  end

  def train_appraisal
    return if @researching

    DRCT.walk_to(@training_room)
    play_song? if DRSkill.getrank('Appraisal') >= 250
    DRC.wait_for_script_to_complete('appraisal')
  end

  def train_arcana
    if @use_research && @settings.research_skills.include?('Arcana')
      do_research('Arcana')
      return
    end

    DRC.wait_for_script_to_complete('sanowret-crystal', ['run'])
  end

  def train_astrology
    DRC.wait_for_script_to_complete('astrology')
  end

  def train_outfitting
    if @settings.train_workorders.include?('Tailoring')
      return unless money_for_training?(5000, 'Outfitting')

      DRC.wait_for_script_to_complete('workorders', ['Tailoring'])
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    end

    DRC.wait_for_script_to_complete('craft', ['outfitting'])
  end

  def train_engineering
    if @settings.train_workorders.include?('Shaping')
      return unless money_for_training?(5000, 'Engineering')

      DRC.wait_for_script_to_complete('workorders', ['Shaping'])
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    elsif @settings.train_workorders.include?('Carving')
      return unless money_for_training?(5000, 'Engineering')

      DRC.wait_for_script_to_complete('workorders', ['Carving'])
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    end

    DRC.wait_for_script_to_complete('craft', ['engineering'])
  end

  def train_trading
    disciplines = @settings.work_order_disciplines

    if @settings.sell_pouches_for_trading && DRSkill.getxp('Trading') < 5
      DRC.wait_for_script_to_complete('sell-pouches')
      return if DRSkill.getxp('Trading') > 5
    end

    unless disciplines
      DRC.beep
      echo('SELECT DISCIPLINES FOR TRADING TRAINING WITH work_order_disciplines:')
      DRC.beep
      pause 5
      return
    end

    discipline = disciplines.min_by { |s| DRSkill.getxp(@disciplines_to_skill[s]) }

    return unless money_for_training?(5000, 'Trading')

    DRC.wait_for_script_to_complete('workorders', [discipline])
    DRC.wait_for_script_to_complete('sell-loot')
    DRCT.walk_to(@training_room)
  end

  def train_enchanting
    eligible = @settings.train_workorders & %w[Artificing]
    unless eligible.empty?
      return unless money_for_training?(20_000, 'Enchanting')

      DRC.wait_for_script_to_complete('workorders', [eligible.first])
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    end

    DRC.wait_for_script_to_complete('craft', ['enchanting'])
  end

  # https://elanthipedia.play.net/Blacksmithing_Products
  def train_forging
    # drf: every Forging discipline in train_workorders is eligible, and the
    # trainer rotates through them -- one work order per call, the next
    # discipline on the next call -- instead of always running the first.
    # Upstream limited the set to Blacksmithing/Weaponsmithing and took
    # `eligible.first`, so a Trader with three smithing disciplines only ever
    # trained one. The cursor is a UserVar so the rotation survives restarts.
    eligible = @settings.train_workorders & %w[Blacksmithing Weaponsmithing Armorsmithing]
    unless eligible.empty?
      materials = @settings.respond_to?(:workorders_materials) ? @settings.workorders_materials : nil
      stock_name = materials.is_a?(Hash) ? materials['metal_type'] : nil
      stock = stock_name && respond_to?(:get_data, true) ? get_data('crafting')&.dig('blacksmithing', @settings.hometown, stock_name) : nil
      stock_cost = stock.is_a?(Hash) ? stock['stock-value'].to_i : 0
      cash_floor = @settings.respond_to?(:workorders_cash_on_hand) ? @settings.workorders_cash_on_hand.to_i : 0
      budget = [cash_floor, 5000, stock_cost.positive? ? stock_cost + 3000 : 0].max
      return unless money_for_training?(budget, 'Forging')

      before_xp = defined?(DRSkill) ? DRSkill.getxp('Forging').to_i : 0
      index = UserVars.crossing_training_forging_next.to_i % eligible.length
      UserVars.crossing_training_forging_next = index + 1
      DRC.wait_for_script_to_complete('workorders', [eligible[index]])
      if defined?(DRSkill) && DRSkill.getxp('Forging').to_i <= before_xp
        echo('Forging workorder made no XP progress, removing Forging from training')
        @settings.crossing_training&.delete('Forging')
      end
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    end

    DRC.wait_for_script_to_complete('craft', ['forging'])
  end

  # https://elanthipedia.play.net/Remedies_products
  def train_alchemy
    if @settings.train_workorders.include?('Remedies')
      return unless money_for_training?(5000, 'Alchemy')

      DRC.wait_for_script_to_complete('workorders', ['Remedies'])
      DRC.wait_for_script_to_complete('sell-loot')
      DRCT.walk_to(@training_room)
      return
    end

    DRC.beep
    echo('*** NOT YET IMPLEMENTED ***')
    @settings.crossing_training.delete('Alchemy')
  end

  def money_for_training?(amount, skill)
    if DRCM.ensure_copper_on_hand(amount, @settings)

      true
    else
      echo("Low on funds, removing #{skill} from training")
      @settings.crossing_training.delete(skill)
      false
    end
  end

  # Reader receipts only refuse stale/unobserved settlement; bytes, native
  # queue entries and parser/cleaner results retain their original behavior.
  require 'weakref'
  class PerformanceArrivalObserver
    READER = :drbot_performance_reader_receipt
    PARSER = :drbot_performance_parser_receipt
    MAX_INPUTS = 4_096
    MAX_INPUT_AGE = 60
    @inputs = {}
    @input_lock = Mutex.new

    class << self
      def record_input(string, receipt)
        @input_lock.synchronize do
          return unless receipt[:owner].instance_variable_get(:@enabled)
          now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
          @inputs.delete_if { |_id, saved| now - saved[:at] > MAX_INPUT_AGE || !saved[:input].weakref_alive? }
          @inputs.shift while @inputs.length >= MAX_INPUTS
          prior = @inputs[string.object_id]
          ambiguous = prior && prior[:input].weakref_alive? && prior[:input].__getobj__.equal?(string)
          at = ambiguous ? [prior[:at], receipt[:at]].min : receipt[:at]
          @inputs[string.object_id] = { input: WeakRef.new(string), owner: receipt[:owner], at: at,
                                       ambiguous: !!ambiguous }.freeze
        end
      end

      def begin_input(string)
        @input_lock.synchronize do
          saved = @inputs.delete(string.object_id)
          context = nil
          if saved && !saved[:ambiguous] && saved[:owner].instance_variable_get(:@enabled) && saved[:input].__getobj__.equal?(string)
            age = Process.clock_gettime(Process::CLOCK_MONOTONIC) - saved[:at]
            context = { owner: saved[:owner], at: saved[:at] } if age.between?(0, MAX_INPUT_AGE)
          end
          Thread.current.thread_variable_set(PARSER, context)
        end
      rescue StandardError
        Thread.current.thread_variable_set(PARSER, nil)
      end

      def restore_context(previous)
        @input_lock.synchronize do
          previous = nil if previous.is_a?(Hash) && previous[:owner].is_a?(PerformanceArrivalObserver) &&
            !previous[:owner].instance_variable_get(:@enabled)
          Thread.current.thread_variable_set(PARSER, previous)
        end
      end

      def reader_receipt(owner, raw, at)
        @input_lock.synchronize do
          Thread.current.thread_variable_set(READER, { owner: owner, raw: raw, at: at }) if
            owner.instance_variable_get(:@enabled)
        end
      end

      def buffer_receipt(context)
        @input_lock.synchronize do
          yield if context && context[:owner].instance_variable_get(:@enabled)
        end
      end

      def clear_inputs(owner)
        @input_lock.synchronize do
          @inputs.delete_if { |_id, saved| saved[:owner].equal?(owner) }
          threads = [Thread.current]
          threads << Game.reader_thread if Game.respond_to?(:reader_thread)
          threads << Game.thread if Game.respond_to?(:thread)
          threads.compact.uniq.each do |thread|
            [READER, PARSER].each do |key|
              context = thread.thread_variable_get(key)
              thread.thread_variable_set(key, nil) if context.is_a?(Hash) && context[:owner].equal?(owner)
            end
          end
          if Game.respond_to?(:game_instance) && (instance = Game.game_instance)
            context = instance.instance_variable_get(:@drbot_performance_buffer_receipt)
            instance.instance_variable_set(:@drbot_performance_buffer_receipt, nil) if
              context.is_a?(Hash) && context[:owner].equal?(owner)
          end
        end
      end
    end

    module QueueObservation
      def enqueue_server_string(string, enqueued_monotonic_at)
        receipt = Thread.current.thread_variable_get(PerformanceArrivalObserver::READER)
        begin
          PerformanceArrivalObserver.record_input(string, receipt) if receipt.is_a?(Hash) &&
            receipt[:owner].is_a?(PerformanceArrivalObserver) && receipt[:owner].active? && receipt[:raw] == string
        rescue StandardError
          # Missing observational metadata denies treatment later; it must not
          # change the native queue's success, exception or byte behavior.
        ensure
          Thread.current.thread_variable_set(PerformanceArrivalObserver::READER, nil) if receipt.is_a?(Hash) &&
            receipt[:owner].is_a?(PerformanceArrivalObserver)
        end
        super
      end

      def process_server_string(string)
        previous = Thread.current.thread_variable_get(PerformanceArrivalObserver::PARSER)
        PerformanceArrivalObserver.begin_input(string)
        super
      ensure
        begin
          PerformanceArrivalObserver.restore_context(previous)
        rescue StandardError
          Thread.current.thread_variable_set(PerformanceArrivalObserver::PARSER, nil)
        end
      end
    end

    module BufferedObservation
      def buffer_room_objs(string)
        context = Thread.current.thread_variable_get(PerformanceArrivalObserver::PARSER)
        pending = !@pending_room_objs.nil?
        retained = @drbot_performance_buffer_receipt
        outcome = super
        begin
          if context && context[:owner].active?
            PerformanceArrivalObserver.buffer_receipt(context) do
              earliest = if pending
                           retained && retained[:owner].equal?(context[:owner]) && retained[:at].is_a?(Numeric) &&
                             context[:at].is_a?(Numeric) ? [retained[:at], context[:at]].min : nil
                         else
                           context[:at]
                         end
              context[:at] = earliest
              @drbot_performance_buffer_receipt = outcome[0] ? context.dup.freeze : nil
            end
          elsif pending || outcome[0]
            @drbot_performance_buffer_receipt = nil
          end
        rescue StandardError
          context[:at] = nil if context.is_a?(Hash)
        end
        outcome
      end
    end

    def initialize(trainer)
      @trainer, @enabled = WeakRef.new(trainer), false
      raise 'native Performance arrival protocol unavailable' unless defined?(Lich::Common::SocketReadHook) &&
        %i[enqueue_server_string unwrap_server_queue_item process_server_string].all? { |name| Game.respond_to?(name) } &&
        defined?(Lich::GameBase::GameInstance::Base)
      Game.singleton_class.prepend(QueueObservation) unless Game.singleton_class.ancestors.include?(QueueObservation)
      base = Lich::GameBase::GameInstance::Base
      base.prepend(BufferedObservation) unless base.ancestors.include?(BufferedObservation)
      @enabled = true
      @hook = "drbot-performance-reader-#{object_id}"
      Lich::Common::SocketReadHook.add(@hook, proc do |raw, event|
        if active? && event.is_a?(Lich::Common::SocketReadHook::Event) && event.monotonic_received_at.is_a?(Numeric)
          self.class.reader_receipt(self, raw, event.monotonic_received_at)
        end
      end)
    end

    def active?
      @enabled && @trainer.weakref_alive? && @trainer.__getobj__.performance_owner_current?(false)
    rescue StandardError
      false
    end

    def context
      context = Thread.current.thread_variable_get(PARSER)
      context if active? && context && context[:owner].equal?(self) && context[:at].is_a?(Numeric)
    end

    def close
      @enabled = false
      Lich::Common::SocketReadHook.remove(@hook) if @hook
      self.class.clear_inputs(self)
    rescue StandardError
      # Disabled metadata cannot settle a command even if cleanup fails.
      nil
    end
  end

  # Capture the actual admitted native family once, before Performance writes.
  # A replacement root, child, producer or character cannot adopt its result.
  def performance_capture_owner
    return nil unless defined?($DRBOT_DIRECT_CONTROL) && $DRBOT_DIRECT_CONTROL

    control = $DRBOT_DIRECT_CONTROL
    child = Script.current
    root = control['scripts']&.first
    return false unless control.is_a?(Hash) && control['lock'].respond_to?(:synchronize) && child && root

    owner = { control: control, child: child, root: root,
              coordinator: (defined?($COORDINATOR) && $COORDINATOR),
              character: XMLData.name.to_s.dup.freeze, game: XMLData.game.to_s.dup.freeze }
    %w[session producer watchdog_epoch fence_epoch].each do |key|
      value = control[key]
      owner[key.to_sym] = value.is_a?(String) ? value.dup.freeze : value
    end
    ancestor, seen = child, []
    until ancestor.nil? || seen.any? { |entry| entry.equal?(ancestor) }
      break if ancestor.equal?(root)
      seen << ancestor
      ancestor = ancestor.respond_to?(:__parent_script, true) ? ancestor.__send__(:__parent_script) : nil
    end
    return false unless ancestor.equal?(root)
    owner.freeze
  rescue StandardError
    false
  end

  def performance_owner_current?(require_caller = true)
    owner = @performance_owner
    return true if owner.nil? && !(defined?($DRBOT_DIRECT_CONTROL) && $DRBOT_DIRECT_CONTROL)
    return false unless owner.is_a?(Hash)

    control = owner[:control]
    $DRBOT_DIRECT_CONTROL.equal?(control) && control['mode'] == 'B' && control['closed'] == false &&
      !control['fenced'] && control['scripts']&.first.equal?(owner[:root]) &&
      %w[session producer watchdog_epoch fence_epoch].all? { |key| control[key] == owner[key.to_sym] } &&
      control['session'].is_a?(String) && !control['session'].empty? &&
      control['producer'].is_a?(String) && !control['producer'].empty? &&
      owner[:watchdog_epoch].is_a?(String) && !owner[:watchdog_epoch].empty? &&
      owner[:fence_epoch].is_a?(Integer) && control['final_write_guard'] == owner[:watchdog_epoch] &&
      XMLData.name.to_s == owner[:character] && XMLData.game.to_s == owner[:game] &&
      (defined?($COORDINATOR) && $COORDINATOR).equal?(owner[:coordinator]) &&
      (!require_caller || Script.current.equal?(owner[:child])) &&
      [owner[:child], owner[:root]].all? { |entry| Script.list.any? { |resident| resident.equal?(entry) } }
  rescue StandardError
    false
  end

  def performance_prepare_persistence
    return true if @performance_owner.nil? && performance_owner_current?
    return performance_persistence_current? if @performance_persistence
    return false unless performance_owner_current? && defined?(Lich::Common::Vars) &&
      defined?(Lich::Common::UserVars) && Vars.equal?(Lich::Common::Vars) &&
      UserVars.equal?(Lich::Common::UserVars) && Vars.class_variable_get(:@@load_state) == :loaded
    cache = Vars.class_variable_get(:@@vars)
    db, mutex = Lich.db, Lich.db_mutex
    filename = db.filename.to_s
    return false unless cache.is_a?(Hash) && !filename.empty? && filename != ':memory:' &&
      mutex.is_a?(Mutex) && !File.symlink?(filename) && File.file?(filename)
    file = File.stat(filename)
    owner = @performance_owner
    @performance_persistence = { vars: Vars, cache: cache, db: db, mutex: mutex,
      filename: File.expand_path(filename).freeze, file_identity: [file.dev, file.ino].freeze,
      scope: "#{owner[:game]}:#{owner[:character]}".encode('UTF-8').freeze }.freeze
    performance_persistence_current?
  rescue StandardError
    false
  end

  def performance_persistence_current?
    state = @performance_persistence
    return false unless state.is_a?(Hash) && performance_owner_current? &&
      # A confirmed retired receipt has no remaining visit obligation.
      # Pending/held receipts retain their exact original visit binding.
      (!@performance_receipt || performance_visit_current? ||
       (@performance_receipt_phase == :cleared &&
        @performance_retired_receipt.equal?(@performance_receipt))) &&
      Lich.db.equal?(state[:db]) && Lich.db_mutex.equal?(state[:mutex]) &&
      Vars.equal?(state[:vars]) && Vars.class_variable_get(:@@load_state) == :loaded &&
      Vars.class_variable_get(:@@vars).equal?(state[:cache]) &&
      File.expand_path(Lich.db.filename.to_s) == state[:filename] && !File.symlink?(state[:filename])
    file = File.stat(state[:filename])
    file.file? && [file.dev, file.ino] == state[:file_identity] &&
      "#{XMLData.game}:#{XMLData.name}" == state[:scope]
  rescue StandardError
    false
  end

  # This is a write-ahead custody receipt, not a new producer authority.
  # Only this object, its admitted child and the parent's active poll may
  # recognize it in memory. A restarted scheduler sees an ordinary hold.
  def performance_visit_current?
    visit = @performance_visit
    visit.is_a?(Array) && defined?(Room) && Room.current &&
      [Room.current.id, XMLData.room_id, XMLData.room_count] == visit &&
      visit.all? { |entry| entry.is_a?(Integer) && entry >= 0 }
  rescue StandardError
    false
  end

  def performance_receipt_current?(record = @performance_receipt)
    owner, state = @performance_owner, @performance_persistence
    record.is_a?(Hash) && record.equal?(@performance_receipt) &&
      [:preparing, :armed, :settling].include?(@performance_receipt_phase) &&
      performance_owner_current?(false) && performance_visit_current? && state.is_a?(Hash) &&
      (state[:cache]['drbot_custody_hold'].equal?(record) ||
        (@performance_receipt_phase == :preparing && state[:cache]['drbot_custody_hold'].nil?)) &&
      owner[:coordinator].instance_variable_get(:@performance_pending_child).equal?(self) &&
      [record['write_floor'], record['write_floor'] + 1].include?(owner[:control]['write_count'])
  rescue StandardError
    false
  end

  def performance_socket_entry_current?
    @performance_socket_entry_record.equal?(@performance_receipt) &&
      @performance_socket_entry_receipt && @performance_socket_entry_receipt.entry_at.is_a?(Numeric)
  rescue StandardError
    false
  end

  def performance_pending_exempt?(parent, record)
    return false unless parent.equal?(@performance_owner&.dig(:coordinator)) &&
      performance_receipt_current?(record)
    caller = Script.current
    poll = Thread.current.thread_variable_get(:drbot_crossing_performance_poll)
    ticket = Thread.current.thread_variable_get(:drbot_crossing_performance_ticket)
    (caller.equal?(@performance_owner[:root]) && poll.is_a?(Array) &&
      poll[0].equal?(parent) && poll[1].equal?(@performance_owner[:child])) ||
      (caller.equal?(@performance_owner[:child]) && ticket.equal?(@performance_ticket))
  end

  def performance_parent_unsettled?(parent)
    parent.equal?(@performance_owner&.dig(:coordinator)) && @performance_receipt &&
      @performance_receipt_phase != :cleared
  end

  def performance_socket_refused?(command)
    return true unless performance_receipt_current? && @performance_receipt_phase == :armed &&
      performance_owner_current? &&
      Thread.current.thread_variable_get(:drbot_crossing_performance_ticket).equal?(@performance_ticket)
    control = @performance_owner[:control]
    command != @performance_receipt['command'] || control['write_count'] != @performance_receipt['write_floor'] ||
      control['pending_result'] != false || checkrt != 0 || checkcastrt != 0 ||
      control['performance_final_write_guard'] != @performance_owner[:watchdog_epoch]
  rescue StandardError
    true
  end

  def performance_persist_hold(record, clear: false)
    state = @performance_persistence
    return false unless record.is_a?(Hash) && performance_persistence_current? &&
      (!clear || performance_socket_entry_current?)
    require 'timeout'
    private_db, committed, adopted, before_cache = nil, false, nil, nil
    Timeout.timeout(2, Timeout::Error) do
      Thread.handle_interrupt(Exception => :never) do
        begin
          private_db = SQLite3::Database.new(state[:filename])
          Thread.handle_interrupt(Exception => :immediate) do
            private_db.busy_timeout(0)
            state[:mutex].synchronize do
              @performance_owner[:control]['lock'].synchronize do
                raise 'Performance persistence binding changed' unless performance_persistence_current?
                raise 'Performance socket entry changed before retirement' if clear && !performance_socket_entry_current?
                cache = state[:cache]
                before_blob = Marshal.dump(cache)
                before_cache = cache.dup
                private_db.execute('BEGIN IMMEDIATE')
                blob = private_db.get_first_value('SELECT hash FROM uservars WHERE scope=?;', [state[:scope]])
                stored = blob ? Marshal.load(blob) : {}
                raise 'Performance stored Vars malformed' unless stored.is_a?(Hash)
                raise 'Performance loaded Vars changed' unless Marshal.dump(cache) == before_blob
                # Newer disk overlaps win; unsaved cache-only keys survive.
                merged = cache.merge(stored)
                independent_disk = stored.any? do |key, value|
                  key.to_s.end_with?('_hold') && !value.nil? &&
                    !(key == 'drbot_custody_hold' && value == record)
                end
                if !clear && @performance_receipt_phase == :preparing && independent_disk
                  # A loaded nil must not erase a hold found on disk during a
                  # later ordinary Vars.save. Adopt only unconflicted original
                  # scope data, without issuing any row update or game write.
                  stored.each do |key, value|
                    next unless key.to_s.end_with?('_hold') && !value.nil?
                    raise 'Performance independent hold conflict' if !cache[key].nil? && cache[key] != value
                  end
                  raise 'Performance adoption binding changed' unless performance_persistence_current? &&
                    Marshal.dump(cache) == before_blob
                  cache.replace(merged)
                  raise 'Performance independent stored hold; preparation refused'
                end
                (stored.keys | cache.keys).each do |key|
                  next unless key.to_s.end_with?('_hold')
                  disk, memory = stored[key], cache[key]
                  raise 'Performance independent hold conflict' if !disk.nil? && !memory.nil? && disk != memory
                  merged[key] = memory if disk.nil? && !memory.nil?
                end
                memory, disk = cache['drbot_custody_hold'], stored['drbot_custody_hold']
                owned_memory = memory.equal?(record) || (!clear && memory.nil? && @performance_receipt_phase == :preparing)
                raise 'Performance custody receipt changed' unless owned_memory &&
                  (disk.nil? || disk == record) && (!clear || disk == record)
                raise 'Performance receipt no longer current' unless performance_receipt_current?(record)
                merged['drbot_custody_hold'] = record
                written = merged.dup
                written.delete('drbot_custody_hold') if clear
                raise 'Performance persistence binding changed' unless performance_persistence_current? &&
                  Marshal.dump(cache) == before_blob
                private_db.execute('INSERT OR REPLACE INTO uservars(scope,hash) VALUES(?,?);',
                  [state[:scope], SQLite3::Blob.new(Marshal.dump(written))])
                check = private_db.get_first_value('SELECT hash FROM uservars WHERE scope=?;', [state[:scope]])
                raise 'Performance custody readback unconfirmed' unless check && Marshal.load(check) == written
                raise 'Performance loaded Vars changed' unless Marshal.dump(cache) == before_blob
                # Adopt disk overlaps BEFORE COMMIT. Keep the receipt in cache
                # until clear commits: an interrupted clear cannot erase it.
                Thread.handle_interrupt(Exception => :never) do
                  raise 'Performance persistence binding changed' unless performance_persistence_current?
                  cache.replace(merged)
                  adopted = Marshal.dump(merged)
                  raise 'Performance cache adoption changed' unless performance_persistence_current? &&
                    Marshal.dump(cache) == adopted && cache['drbot_custody_hold'].equal?(record)
                  # SQLite invokes this private connection's transaction
                  # authorizer at COMMIT preparation, after any Ruby adapter
                  # callbacks. Recheck the captured raw visit/cache there too.
                  private_db.authorizer do |operation, action, *_|
                    if operation == 22 && action == 'COMMIT' # SQLITE_TRANSACTION
                      begin
                        performance_persistence_current? && performance_receipt_current?(record) &&
                          (!clear || performance_socket_entry_current?) &&
                          Marshal.dump(cache) == adopted ? 0 : 1
                      rescue StandardError
                        1
                      end
                    else
                      0
                    end
                  end
                  private_db.execute('COMMIT')
                  committed = true
                  raise 'Performance persistence binding changed' unless performance_persistence_current? &&
                    (!clear || performance_socket_entry_current?) &&
                    Marshal.dump(cache) == adopted && cache['drbot_custody_hold'].equal?(record)
                  cache.delete('drbot_custody_hold') if clear
                end
              end
            end
          end
        ensure
          private_db.execute('ROLLBACK') rescue nil unless committed
          private_db.close rescue nil
          # Never restore into a replacement scope/cache. The original receipt
          # remains protective even if adoption or SQL failed.
          if !committed && adopted && performance_persistence_current? &&
              Marshal.dump(state[:cache]) == adopted
            state[:cache].replace(before_cache)
          end
        end
      end
    end
    clear && committed ? :retired : committed && performance_persistence_current?
  rescue StandardError
    # A completed COMMIT retires a command whose own positive result and
    # settled custody were already verified. Subsequent drift is no longer an
    # unknown command, and it cannot authorize this old child to continue.
    clear && committed ? :retired : false
  end

  def performance_prepare_receipt(command)
    return false unless performance_prepare_persistence && performance_write_admitted?
    owner, control = @performance_owner, @performance_owner[:control]
    record = nil
    control['lock'].synchronize do
      return false unless performance_persistence_current? && performance_write_admitted? &&
        control['performance_final_write_guard'] == owner[:watchdog_epoch] &&
        control['write_count'].is_a?(Integer) && control['pending_result'] == false &&
        checkrt == 0 && checkcastrt == 0 && @performance_persistence[:cache]['drbot_custody_hold'].nil?
      @performance_visit = [Room.current.id, XMLData.room_id, XMLData.room_count].freeze
      return false unless performance_visit_current?
      record = { 'reason' => 'Performance command pending; operator reconciliation required',
        'since' => Time.now.to_f, 'command' => command.dup.freeze,
        'write_floor' => control['write_count'], 'pending_result' => true }.freeze
      @performance_receipt, @performance_ticket = record, Object.new
      @performance_receipt_phase = :preparing
      @performance_receipt_durable = false
      owner[:coordinator].instance_variable_set(:@performance_pending_child, self)
      control['performance_write_refusal'] = method(:performance_socket_refused?)
    end
    result = performance_persist_hold(record)
    control['lock'].synchronize do
      if performance_owner_current?
        @performance_receipt_phase = result ? :armed : :held
        @performance_receipt_durable = result == true
      end
    end
    result
  end

  def performance_clear_receipt
    record = @performance_receipt
    return false unless performance_receipt_current?(record) && performance_socket_entry_current?
    @performance_receipt_phase = :settling
    return false unless performance_persist_hold(record, clear: true) == :retired
    @performance_retired_receipt = record
    owner = @performance_owner
    owner[:control]['lock'].synchronize do
      return :retired unless performance_owner_current? && performance_visit_current? &&
        performance_socket_entry_current? &&
        owner[:coordinator].instance_variable_get(:@performance_pending_child).equal?(self) &&
        @performance_persistence[:cache]['drbot_custody_hold'].nil?
      owner[:control].delete('performance_write_refusal')
      owner[:coordinator].remove_instance_variable(:@performance_pending_child)
      @performance_receipt_phase = :cleared
    end
    true
  end

  def performance_stop_hold(reason)
    # Retain this child before DB work. A SQL failure does not release the
    # parent/pending stop, and an old child never mutates a successor's cache.
    owner = @performance_owner
    if owner.is_a?(Hash)
      owner[:control]['lock'].synchronize do
        if performance_owner_current?
          @performance_receipt_phase = :held if @performance_receipt
          parent = owner[:coordinator]
          prior = parent&.instance_variable_get(:@task_hold)
          parent.instance_variable_set(:@task_hold, "Performance: #{reason}; operator reconciliation required") if parent && !prior
          @performance_persistence_unconfirmed = true unless @performance_receipt_durable
        end
      end
    end
    echo "***COORDINATOR HOLD*** #{reason}; operator reconciliation required"
    loop { pause 60 }
  end

  def performance_write_admitted?
    return false unless performance_owner_current?
    owner = @performance_owner
    return true unless owner.is_a?(Hash)
    policy = defined?(DrbotLifecycleDeadline) && DrbotLifecycleDeadline.current
    return false if policy && !policy.bound?
    parent = owner[:coordinator]
    state = @performance_persistence
    cache = state && state[:cache]
    return false unless cache.is_a?(Hash)
    return false unless cache['drbot_weapon_custody_hold'].nil?
    generic = cache['drbot_custody_hold']
    return false unless generic.nil? || performance_pending_exempt?(parent, generic)
    independent = cache['coordinator_safety_hold']
    return false if !independent.nil? && !(policy && independent.is_a?(Hash) && independent['reason'] == policy.reason)
    hold = parent.schedule_hold_reason if parent && parent.respond_to?(:schedule_hold_reason)
    cache['coordinator_safety_hold'] = independent if cache && independent && performance_owner_current?
    !hold || (policy && hold == policy.reason)
  end

  def performance_retain_unknown(count)
    owner = @performance_owner
    return false unless owner.is_a?(Hash)
    control = owner[:control]
    hook = "crossing-performance-unknown-#{owner[:child].object_id}-#{object_id}"
    control['lock'].synchronize do
      return false unless performance_owner_current? && control['write_count'] == count
      control['pending_result'] = true
      @performance_unknown = count
      DownstreamHook.add(hook, proc do |raw|
        control['lock'].synchronize do
          # Later prompts cannot discharge the original written obligation.
          # Script death removes this hook; a successor cannot inherit it.
          control['pending_result'] = true if performance_owner_current?(false) &&
            @performance_unknown == count && control['write_count'] == count
        end
        raw
      end, persist: false)
    end
    true
  end

  def performance_command_once(command, patterns, reason, refusals = [], settled_custody = nil, &custody)
    observer = nil
    entry_receipt = nil
    @performance_owner = performance_capture_owner unless instance_variable_defined?(:@performance_owner)
    performance_stop_hold("#{reason}: original producer changed") unless performance_owner_current?
    # Preserve ordinary standalone Lich usage. Managed lifecycles use the raw
    # command frame below; this fallback grants no managed producer authority.
    if @performance_owner.nil?
      reply = command == 'stop play' ? DRC.stop_playing : DRC.bput(command, *patterns)
      known = command == 'stop play' ? reply.to_s.match?(/You stop playing your song|But you're not performing|In the name of/) :
        patterns.any? { |pattern| reply.to_s.match?(pattern) }
      performance_stop_hold("#{reason} result unconfirmed") unless known
      waitrt?
      return true
    end

    begin
      raise 'native game socket observation unavailable' unless defined?(DrbotGameSocketEntry)
      entry_receipt = DrbotGameSocketEntry.capture("#{$cmd_prefix}#{command}")
      observer = PerformanceArrivalObserver.new(self)
      before_dying { observer.close; entry_receipt.close } if defined?(before_dying)
    rescue StandardError
      observer.close if observer
      entry_receipt.close if entry_receipt
      performance_stop_hold("#{reason}: native command observation protocol unavailable")
    end
    unless performance_prepare_receipt(command)
      observer.close
      performance_stop_hold("#{reason}: custody preparation unconfirmed")
    end
    @performance_socket_entry_receipt = entry_receipt
    @performance_socket_entry_record = @performance_receipt
    require 'timeout'
    owner = @performance_owner
    control = owner[:control]
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 30
    frame_lock = Mutex.new
    frame, armed, closed, count = +'', false, false, nil
    generation, start_generation, closing_generation, recognized, known_refusal = nil, nil, nil, false, false
    accepted_prompts = []
    hook = "crossing-performance-#{owner[:child].object_id}-#{object_id}"
    previous = Thread.current.thread_variable_get(:drbot_final_write_guard)
    prior_ticket = Thread.current.thread_variable_get(:drbot_crossing_performance_ticket)
    DownstreamHook.add(hook, proc do |raw|
      frame_lock.synchronize do
        arrival = observer.context
        socket_entry_at = entry_receipt.entry_at
        if armed && !closed && socket_entry_at && arrival && arrival[:at] > socket_entry_at
          part = raw.to_s
          offset = frame.length
          frame << part
          current_generation = control['prompt_generation']
          if current_generation.is_a?(Integer) && current_generation > generation
            part.to_enum(:scan, /<prompt(?:\s|>)/).each do
              accepted_prompts << [offset + Regexp.last_match.begin(0), current_generation]
            end
          end
          # Keep raw positions: a prompt before the reply, even in the same
          # packet, cannot close that reply. XML prompt contents never count
          # as command prose, and only a complete watchdog-accepted prompt
          # after the specific reply can settle this once-written command.
          frame.to_enum(:scan, /<prompt\b[^>]*>.*?<\/prompt>/m).each do
            prompt = Regexp.last_match
            receipt = accepted_prompts.find { |position, _| position == prompt.begin(0) }
            next unless receipt && receipt[1] > start_generation
            prose = strip_xml(frame[0...prompt.begin(0)]).to_s.gsub(/\r\n?/, "\n").rstrip
            positive = patterns.any? { |pattern| prose.match?(pattern) }
            refusal = refusals.any? { |pattern| prose.match?(pattern) }
            next unless positive || refusal
            recognized, known_refusal = positive, refusal && !positive
            closing_generation = receipt[1]
            frame = frame[0...prompt.end(0)]
            closed = true
            break
          end
          generation = current_generation
          closed = true if frame.bytesize > 65_536
        end
      end
      raw
    end, persist: false)
    guard = lambda do |actual|
      refused = previous.respond_to?(:call) && previous.call(actual)
      refused ||= actual != command || !performance_write_admitted? || !performance_persistence_current? ||
        control['pending_result'] != false || checkrt != 0 || checkcastrt != 0 ||
        Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline || (custody && !custody.call)
      unless refused
        frame_lock.synchronize do
          refused = armed
          unless refused
            count = control['write_count']
            generation = start_generation = control['prompt_generation']
            refused = !count.is_a?(Integer) || !generation.is_a?(Integer)
            unless refused
              refused = !entry_receipt.arm(guard)
              armed = !refused
            end
          end
        end
      end
      refused
    end
    failure = nil
    begin
      Thread.current.thread_variable_set(:drbot_crossing_performance_ticket, @performance_ticket)
      Thread.current.thread_variable_set(:drbot_final_write_guard, guard)
      Timeout.timeout(30, Timeout::Error) do
        entry_receipt.with_active { put(command) } # one socket attempt; no bput retry or recovery fallback
        raise "#{reason}: write unconfirmed" unless armed && entry_receipt.entry_at && performance_owner_current? &&
          control['write_count'] == count + 1
        loop do
          raise "#{reason}: original producer or command changed" unless performance_owner_current? &&
            @performance_socket_entry_receipt.equal?(entry_receipt) && performance_socket_entry_current? &&
            control['write_count'] == count + 1
          complete, reply = frame_lock.synchronize { [closed, frame.dup] }
          if complete
            if known_refusal && !recognized
              failure = "#{reason}: command refused; custody unresolved"
              break
            end
            raise "#{reason}: result unconfirmed" unless reply.bytesize <= 65_536 &&
              recognized && closing_generation.is_a?(Integer) &&
              control['prompt_generation'] >= closing_generation && closing_generation > start_generation
            if control['pending_result'] == false && checkrt == 0 && checkcastrt == 0
              raise "#{reason}: settled custody unconfirmed" if settled_custody && !settled_custody.call
              break
            end
          end
          raise "#{reason}: prompt or roundtime unconfirmed" if
            Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
          pause 0.05
        end
      end
      unless failure
        raise "#{reason}: socket entry changed before retirement" unless
          @performance_socket_entry_receipt.equal?(entry_receipt) && performance_socket_entry_current?
        retired = performance_clear_receipt
        raise "#{reason}: custody clear unconfirmed" unless retired
        if retired == :retired
          failure = "#{reason}: binding changed after confirmed command retirement"
        end
      end
      true
    rescue Timeout::Error, StandardError
      failure = "#{reason}: command settlement unconfirmed"
    ensure
      Thread.current.thread_variable_set(:drbot_final_write_guard, previous)
      Thread.current.thread_variable_set(:drbot_crossing_performance_ticket, prior_ticket)
      DownstreamHook.remove(hook)
    end
    if failure
      @performance_unknown_command = command.dup.freeze
      performance_retain_unknown(count + 1) if armed && count.is_a?(Integer) && !known_refusal &&
        !@performance_retired_receipt.equal?(@performance_receipt)
      observer.close
      performance_stop_hold(failure)
    end
    true
  ensure
    observer.close if observer
    entry_receipt.close if entry_receipt
  end

  def performance_capture_instrument
    return unless defined?(GameObj)
    instrument = @settings.instrument.to_s
    return if instrument.empty?
    held = [GameObj.left_hand, GameObj.right_hand].compact.reject { |item| item.name.to_s == 'Empty' }
    selected = held.select { |item| item.name.to_s.match?(/\b#{Regexp.escape(instrument)}\z/i) }
    @performance_instrument ||= [selected.first.id, selected.first.name, selected.first.noun].freeze if selected.length == 1
  end

  def performance_final_admitted?
    return false unless performance_owner_current?
    policy = defined?(DrbotLifecycleDeadline) && DrbotLifecycleDeadline.current
    return true unless policy && policy.lanjefast?

    policy.respond_to?(:crossing_instrument_admitted?) && policy.crossing_instrument_admitted?(self)
  end

  def finish_performance_instrument
    return true unless @running == false && stopping?
    performance_stop_hold('Performance final owner changed') unless performance_owner_current?
    instrument = @settings.instrument.to_s
    held = [GameObj.left_hand, GameObj.right_hand].compact.reject { |item| item.name.to_s == 'Empty' }
    return true if held.empty?
    performance_stop_hold('Performance worn instrument has unexpected hand custody') if instrument.empty?
    performance_stop_hold('crossing instrument stow safety or owner changed') unless performance_final_admitted?
    storage = Array(@settings.storage_containers).first.to_s
    safe = /\A[a-zA-Z][a-zA-Z '\-]{0,79}\z/
    custody = lambda do
      hands = [GameObj.left_hand, GameObj.right_hand].compact.reject { |item| item.name.to_s == 'Empty' }
      performance_final_admitted? && hands.length == 1 && @performance_instrument &&
        [hands.first.id, hands.first.name, hands.first.noun] == @performance_instrument &&
        hands.first.name.to_s.match?(/\b#{Regexp.escape(instrument)}\z/i)
    end
    performance_stop_hold('Performance final held gear is not the captured instrument') unless
      instrument.match?(safe) && storage.match?(safe) && custody.call
    performance_stop_hold('Performance instrument stow already attempted') if @performance_stow_attempted
    @performance_stow_attempted = true
    receipt = /(?:\A|\n)You put (?:your |some |a |an |the )?[^\n]*\b#{Regexp.escape(instrument)} (?:in|inside) (?:your |a |an |the )?[^\n]*\b#{Regexp.escape(storage)}[.!](?:\n|\z)/i
    performance_command_once("put my #{instrument} in my #{storage}", [receipt], 'crossing instrument stow',
      [/(?:\A|\n)(?:You can't put|You cannot put|What were you referring to|That is closed|You aren't holding)[^\n]*(?:\n|\z)/],
      lambda { [GameObj.left_hand, GameObj.right_hand].compact.all? { |item| item.name.to_s == 'Empty' } }, &custody)
    performance_stop_hold('crossing instrument stow hands unconfirmed after stow') unless
      [GameObj.left_hand, GameObj.right_hand].compact.all? { |item| item.name.to_s == 'Empty' }
    true
  end

  def stop_play
    if @did_play
      patterns = [/(?:\A|\n)You stop playing your song[.!](?:\n|\z)/,
                  /(?:\A|\n)In the name of love\?(?:\n|\z)/,
                  /(?:\A|\n)But you're not performing[^\n]*(?:\n|\z)/]
      performance_command_once('stop play', patterns, 'STOP PLAY')
      @did_play = false
      Flags['ct-song'] = true
    end
    finish_performance_instrument
    true
  end

  def repair_instrument?(worn = false)
    return false unless defined?(DRCI) && defined?(DRC)

    instrument = worn ? @settings.worn_instrument : @settings.instrument
    return false if instrument.to_s.strip.empty?

    kit = @settings.respond_to?(:repair_kit) && @settings.repair_kit ? @settings.repair_kit : 'repair kit'
    unless DRCI.in_hands?(kit) || DRCI.get_item?(kit)
      DRCI.stow_item?(instrument) if !worn && DRCI.in_hands?(instrument)
      return false
    end

    if worn
      unless DRCI.in_hands?(instrument) || DRCI.remove_item?(instrument)
        DRCI.stow_item?(kit)
        return false
      end
    elsif !DRCI.in_hands?(instrument) && !DRCI.get_item?(instrument)
      DRCI.stow_item?(kit)
      return false
    end

    repaired = false
    case DRC.bput("repair my #{instrument}",
                  'fully repaired',
                  'not in need of repair',
                  'Roundtime',
                  'You lack the proper tools',
                  'You must be holding',
                  'What were you referring to')
    when 'fully repaired', 'not in need of repair', 'Roundtime'
      repaired = true
    end
    waitrt?
    DRCI.stow_item?(kit)
    if worn
      DRCI.wear_item?(instrument) if repaired
    elsif !repaired && DRCI.in_hands?(instrument)
      DRCI.stow_item?(instrument)
    end
    repaired
  end

  def clean_instrument?(worn = false)
    return false unless defined?(DRC) && DRC.respond_to?(:clean_instrument)

    DRC.clean_instrument(@settings, worn)
  end

  def play_song?(blocking = false)
    return true if @stop
    return true if @researching
    return false if @no_instrument
    return true if DRSkill.getxp('Performance') >= 28

    @performance_owner = performance_capture_owner unless instance_variable_defined?(:@performance_owner)
    performance_stop_hold('Performance original producer changed') unless performance_owner_current?
    is_instrument_worn = @settings.instrument.nil?
    Flags.reset('ct-no-instrument')
    Flags.reset('ct-damaged-instrument')
    Flags.reset('ct-dirty-instrument')
    Flags.reset('ct-cleaned-instrument')
    # Reset before the PLAY write. A short song can finish while play_song?
    # processes the command result; resetting after it would lose that event.
    Flags.reset('ct-song')
    @did_play = DRC.play_song?(@settings, @song_list, is_instrument_worn, false)
    performance_capture_instrument

    if !@did_play && Flags['ct-damaged-instrument']
      if respond_to?(:repair_instrument?, true) && repair_instrument?(is_instrument_worn)
        Flags.reset('ct-no-instrument')
        Flags.reset('ct-damaged-instrument')
        Flags.reset('ct-dirty-instrument')
        Flags.reset('ct-cleaned-instrument')
        Flags.reset('ct-song')
        @did_play = DRC.play_song?(@settings, @song_list, is_instrument_worn, false)
      else
        @no_instrument = true
        return false
      end
    end

    # DRC.play_song? skips clean_instrument below rank 20 and still returns
    # true when clean_instrument fails without a cloth. Clean below rank 20, or
    # stop the dirty song and skip Performance for the pass when uncleaned.
    if Flags['ct-dirty-instrument'] && !Flags['ct-cleaned-instrument']
      if @did_play && DRSkill.respond_to?(:getrank) && DRSkill.getrank('Performance').to_i < 20 &&
         respond_to?(:clean_instrument?, true) && clean_instrument?(is_instrument_worn)
        Flags.reset('ct-no-instrument')
        Flags.reset('ct-damaged-instrument')
        Flags.reset('ct-dirty-instrument')
        Flags.reset('ct-cleaned-instrument')
        Flags.reset('ct-song')
        @did_play = DRC.play_song?(@settings, @song_list, is_instrument_worn, true)
      else
        @did_play = true
        @no_instrument = true
        stop_play
        return false
      end
    end
    performance_capture_instrument
    @no_instrument = Flags['ct-no-instrument'] && !@did_play

    if @stop
      stop_play
      return true
    end
    return false unless @did_play
    return true unless blocking

    deadline = Time.now + 300
    pause 1 until Flags['ct-song'] || @stop || Time.now >= deadline
    if @stop
      stop_play
      return true
    end
    return true if Flags['ct-song']

    echo '***PERFORMANCE TIMEOUT*** song did not finish in 300 seconds'
    @no_instrument = true
    stop_play
    false
  end
end

before_dying do
  Flags.delete('ct-song')
  Flags.delete('ct-no-instrument')
  Flags.delete('ct-damaged-instrument')
  Flags.delete('ct-dirty-instrument')
  Flags.delete('ct-cleaned-instrument')
  Flags.delete('research-partial')
  Flags.delete('research-complete')
end

# Call this last to avoid the need for forward declarations
$CROSSING_TRAINER = CrossingTraining.new
$CROSSING_TRAINER.main
