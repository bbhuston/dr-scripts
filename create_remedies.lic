=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#create_remedies
=end

class CreateRemedies
  def initialize
    @settings = get_settings
    arg_definitions = [
      [
        { name: 'target', regex: /\w+/, description: 'Recipe.' },
        { name: 'tools', regex: /tools/i, optional: true, description: 'Use clerk-tools to get and store tools.' },
        { name: 'debug', regex: /debug/i, optional: true, description: 'Debug mode.' },
        { name: 'catalyst', regex: /\w+/i, variable: true, optional: true, description: 'Catalyst to use. Default is coal.' }
      ]
    ]

    args = parse_args(arg_definitions)
    tools = args.tools
    debug = args.debug
    catalyst = args.catalyst || "coal nugget"
    DRC.message("catalyst = #{catalyst}") if debug

    # Get recipe
    recipe = get_data('recipes').crafting_recipes.find { |each_recipe| each_recipe['name'] =~ /#{args.target}/i }
    DRC.message("Recipe is: #{recipe}.") if debug
    # Tools, solvent and catalyst first: no herb is foraged or crafted without
    # them, and remedy.lic stops at the first one it cannot get. With `tools`,
    # clerk-tools hands the tools over below, so only the supplies are checked.
    wanted = (tools ? [] : remedy_tools(recipe)) + consumables(recipe, catalyst)
    missing = wanted.reject { |name| supply_available?(name) }
    unless missing.empty?
      reason = 'missing ' + missing.map { |name| [name, supply_container(name)].compact.join(' in ') }.join(', ')
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
      DRC.message("***STATUS*** create_remedies skipped #{recipe['name']}: #{reason}")
      exit
    end
    # Gather first herb section based on settings
    herb1 = recipe['herb1']
    if herb1 == "red flower"
      DRC.message("In herb1 red flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first dried flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "dried flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    elsif herb1 == "blue flower"
      DRC.message("In herb1 blue flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first crushed flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "crushed flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    else
      get_prep_herb(recipe['herb1']) if herb_count(herb1) < 25
    end
    primary_count = herb_count(herb1)
    if primary_count < 25
      reason = "insufficient #{herb1} (#{primary_count}/25)"
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
      DRC.message("***STATUS*** create_remedies skipped #{recipe['name']}: #{reason}")
      exit
    end
    # Gather second herb if necessary
    if !recipe['herb2'].nil? && recipe['herb2'] != 'na' && !%w[water alcohol catalyst nugget].include?(recipe['herb2']) && recipe['herb2'] != 'coal nugget'
      get_prep_herb(recipe['herb2']) unless herb_exists?(recipe['herb2'])
      unless herb_exists?(recipe['herb2'])
        reason = "missing secondary ingredient #{recipe['herb2']}"
        Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
        DRC.message("***STATUS*** create_remedies skipped #{recipe['name']}: #{reason}")
        exit
      end
    end
    # Get tools?
    get_store_tools("get") if tools
    # Craft call section
    if recipe['herb2'].nil?
      herb2_needed = 'na'
      child = DRC.wait_for_script_to_complete('remedy', ['remedies', recipe['chapter'], recipe['name'], herb1, herb2_needed, catalyst, recipe['container'], recipe['noun']])
    else
      child = DRC.wait_for_script_to_complete('remedy', ['remedies', recipe['chapter'], recipe['name'], herb1, recipe['herb2'], catalyst, recipe['container'], recipe['noun']])
    end
    if child.respond_to?(:drbot_remedy_unavailable) && child.drbot_remedy_unavailable
      reason = child.drbot_remedy_unavailable
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
    elsif child.respond_to?(:drbot_crafting_missing_item) && child.drbot_crafting_missing_item
      # The coordinator stopped remedy mid-recipe for a missing item. Put the
      # vessel back in the crafting container with whatever it holds, and back
      # off like any other missing supply.
      reason = "remedy stopped: missing #{child.drbot_crafting_missing_item}"
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
      DRC.message("***STATUS*** create_remedies stopped #{recipe['name']}: #{reason}")
      put_away_after_stop(recipe, [herb1, recipe['herb2']])
    elsif @settings.crafting_container && [DRC.left_hand, DRC.right_hand].compact.any? { |h| h =~ /\b#{Regexp.escape(recipe['noun'])}\b/i }
      DRCC.stow_crafting_item(recipe['noun'], @settings.crafting_container, @settings.alchemy_belt)
    end
    # Store tools?
    get_store_tools("store") if tools
  end

  # Every remedy takes a solvent and a catalyst besides its herbs. A recipe
  # that names its liquid takes that one. Otherwise wound remedies (chapters 3
  # and 4 of the remedies book) take water and scar remedies (5 and 6) alcohol,
  # and for another chapter remedy.lic may ask for either. A water_container or
  # alcohol_container is remedy.lic's own supply.
  def consumables(recipe, catalyst)
    solvents = if %w[water alcohol].include?(recipe['liquid'])
                 [recipe['liquid']]
               else
                 case recipe['chapter'].to_i
                 when 3, 4 then %w[water]
                 when 5, 6 then %w[alcohol]
                 else %w[water alcohol]
                 end
               end
    supplied = { 'water' => @settings.water_container, 'alcohol' => @settings.alcohol_container }
    solvents.reject { |solvent| supplied[solvent] } + [catalyst]
  end

  # The tools remedy.lic takes, named as it names them: the remedies book
  # (unless a master book is set), the vessel its resolve_container finds in
  # alchemy_tools, the pestle (a mixing stick for anything but a mortar) and the
  # sieve. Without them a stop leaves herbs in the vessel, and every retry after
  # the coordinator's delay would spend another batch.
  def remedy_tools(recipe)
    tools = @settings.alchemy_tools.to_a
    vessel = remedy_vessel(recipe)
    stirrer = /mort/ =~ vessel ? (tools.find { |tool| /pestle/ =~ tool } || 'pestle') : 'mixing stick'
    book = 'remed book' unless @settings.master_crafting_book
    [book, vessel, stirrer, 'sieve'].compact
  end

  def remedy_vessel(recipe)
    pattern = recipe['container'] =~ /bowl/ ? /cauldron|bowl/ : /#{recipe['container']}/
    @settings.alchemy_tools.to_a.find { |tool| pattern =~ tool } || recipe['container']
  end

  # After a stop, put back what remedy.lic had out: first any herb stack it
  # held (into the herb container, as remedy.lic stows herbs; a held name that
  # ends in the herb, so not an unfinished georin salve), then the vessel with
  # its unfinished remedy. While gathering herbs remedy.lic keeps the vessel at
  # its feet, so a vessel not in hand is lifted from there first.
  def put_away_after_stop(recipe, herbs)
    bag = @settings.crafting_container
    return unless bag

    belt = @settings.alchemy_belt
    herbs = herbs.compact - ['na', 'water', 'alcohol', 'catalyst', 'nugget', 'coal nugget']
    [DRC.right_hand, DRC.left_hand].compact.each do |item|
      herb = herbs.find { |name| item =~ /\b#{Regexp.escape(name)}\z/i }
      DRCC.stow_crafting_item(herb, @settings.herb_container || bag, belt) if herb
    end
    vessel = remedy_vessel(recipe)
    DRCI.lift?(vessel) unless held?(vessel)
    DRCC.stow_crafting_item(vessel, bag, belt) if held?(vessel)
  end

  def held?(noun)
    [DRC.left_hand, DRC.right_hand].compact.any? { |item| item =~ /\b#{Regexp.escape(noun)}\b/i }
  end

  # remedy.lic takes each with DRCC.get_crafting_item: from the crafting
  # container when crafting_items_in_container lists it, otherwise with a plain
  # GET, and one already held counts. Look only there: on 2026-09-29 Agondar's
  # backpack held five waters that his remedy, asking the purple sack, never
  # reached.
  def supply_container(name)
    bag = @settings.crafting_container
    bag if bag && @settings.crafting_items_in_container.to_a.include?(name)
  end

  def supply_available?(name)
    DRCI.in_hands?(name) || DRCI.exists?(name, supply_container(name))
  end

  def herb_containers
    [@settings.herb_container || 'backpack', @settings.crafting_container].compact.uniq
  end

  def herb_exists?(herb)
    herb_containers.any? { |container| DRCI.exists?(herb, container) }
  end

  def herb_count(herb)
    total = 0
    herb_containers.each do |container|
      next unless DRCI.exists?(herb, container)

      $ORDINALS.each do |ordinal|
        case DRC.bput("count #{ordinal} #{herb} in my #{container}",
                      'I could not find what you were referring to.',
                      'You count out \d+ pieces of material there',
                      'tell you much of anything.')
        when /You count out (\d+) pieces of material there/
          total += Regexp.last_match(1).to_i
        else
          break
        end
        return total if total >= 25
      end
    end
    total
  end

  def get_prep_herb(herb)
    DRC.wait_for_script_to_complete('alchemy', [herb, 'forage', 25])
    DRC.wait_for_script_to_complete('alchemy', [herb, 'prepare'])
  end

  def get_store_tools(option)
    DRC.message("Option for tools is: {option}.") if debug
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'get']) if option == "get"
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'store']) if option == "store"
  end
end
CreateRemedies.new
