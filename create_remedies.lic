=begin
  Documentation: https://elanthipedia.play.net/Lich_script_repository#create_remedies
=end

class CreateRemedies
  def initialize
    @settings = get_settings
    arg_definitions = [
      [
        { name: 'target', regex: /\w+/, description: 'Recipe.' },
        { name: 'tools', regex: /tools/i, optional: true, description: 'Use clerk-tools to get and store tools.' },
        { name: 'debug', regex: /debug/i, optional: true, description: 'Debug mode.' },
        { name: 'catalyst', regex: /\w+/i, variable: true, optional: true, description: 'Catalyst to use. Default is coal.' }
      ]
    ]

    args = parse_args(arg_definitions)
    tools = args.tools
    debug = args.debug
    catalyst = args.catalyst || "coal nugget"
    DRC.message("catalyst = #{catalyst}") if debug

    # Get recipe
    recipe = get_data('recipes').crafting_recipes.find { |each_recipe| each_recipe['name'] =~ /#{args.target}/i }
    DRC.message("Recipe is: #{recipe}.") if debug
    # Gather first herb section based on settings
    herb1 = recipe['herb1']
    if herb1 == "red flower"
      DRC.message("In herb1 red flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first dried flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "dried flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    elsif herb1 == "blue flower"
      DRC.message("In herb1 blue flower check") if debug
      get_prep_herb(herb1) unless DRC.bput("tap first crushed flower", "You tap", "What were", "I could not") =~ /You tap/
      herb1 = "crushed flower"
      DRC.message("recipe herb1 is now: #{herb1}") if debug
    else
      get_prep_herb(recipe['herb1']) if herb_count(herb1) < 25
    end
    primary_count = herb_count(herb1)
    if primary_count < 25
      reason = "insufficient #{herb1} (#{primary_count}/25)"
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
      DRC.message("***STATUS*** create_remedies skipped #{recipe['name']}: #{reason}")
      exit
    end
    # Gather second herb if necessary
    if !recipe['herb2'].nil? && recipe['herb2'] != 'na' && !%w[water alcohol catalyst nugget].include?(recipe['herb2']) && recipe['herb2'] != 'coal nugget'
      get_prep_herb(recipe['herb2']) unless herb_exists?(recipe['herb2'])
      unless herb_exists?(recipe['herb2'])
        reason = "missing secondary ingredient #{recipe['herb2']}"
        Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
        DRC.message("***STATUS*** create_remedies skipped #{recipe['name']}: #{reason}")
        exit
      end
    end
    # Get tools?
    get_store_tools("get") if tools
    # Craft call section
    if recipe['herb2'].nil?
      herb2_needed = 'na'
      child = DRC.wait_for_script_to_complete('remedy', ['remedies', recipe['chapter'], recipe['name'], herb1, herb2_needed, catalyst, recipe['container'], recipe['noun']])
    else
      child = DRC.wait_for_script_to_complete('remedy', ['remedies', recipe['chapter'], recipe['name'], herb1, recipe['herb2'], catalyst, recipe['container'], recipe['noun']])
    end
    if child.respond_to?(:drbot_remedy_unavailable) && child.drbot_remedy_unavailable
      reason = child.drbot_remedy_unavailable
      Script.current.define_singleton_method(:drbot_remedy_unavailable) { reason }
    elsif @settings.crafting_container && [DRC.left_hand, DRC.right_hand].compact.any? { |h| h =~ /\b#{Regexp.escape(recipe['noun'])}\b/i }
      DRCC.stow_crafting_item(recipe['noun'], @settings.crafting_container, @settings.alchemy_belt)
    end
    # Store tools?
    get_store_tools("store") if tools
  end

  def herb_containers
    [@settings.herb_container || 'backpack', @settings.crafting_container].compact.uniq
  end

  def herb_exists?(herb)
    herb_containers.any? { |container| DRCI.exists?(herb, container) }
  end

  def herb_count(herb)
    total = 0
    herb_containers.each do |container|
      next unless DRCI.exists?(herb, container)

      $ORDINALS.each do |ordinal|
        case DRC.bput("count #{ordinal} #{herb} in my #{container}",
                      'I could not find what you were referring to.',
                      'You count out \d+ pieces of material there',
                      'tell you much of anything.')
        when /You count out (\d+) pieces of material there/
          total += Regexp.last_match(1).to_i
        else
          break
        end
        return total if total >= 25
      end
    end
    total
  end

  def get_prep_herb(herb)
    DRC.wait_for_script_to_complete('alchemy', [herb, 'forage', 25])
    DRC.wait_for_script_to_complete('alchemy', [herb, 'prepare'])
  end

  def get_store_tools(option)
    DRC.message("Option for tools is: {option}.") if debug
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'get']) if option == "get"
    DRC.wait_for_script_to_complete('clerk-tools', ['alchemy', 'store']) if option == "store"
  end
end
CreateRemedies.new
